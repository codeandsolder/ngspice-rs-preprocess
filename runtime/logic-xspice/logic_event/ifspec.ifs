NAME_TABLE:
Spice_Model_Name:      preprocess_logic_event
C_Function_Name:       cm_preprocess_logic_event
Description:           "Hybrid logic gate with analog input qualification"

PORT_TABLE:
Port_Name:             in               out
Description:           "logic inputs"   "logic output"
Direction:             in               out
Default_Type:          v                d
Allowed_Types:         [v,vd]           [d]
Vector:                yes              no
Vector_Bounds:         [1 -]            -
Null_Allowed:          no               no

PARAMETER_TABLE:
Parameter_Name:        operation         delay             inertial        ic
Description:           "operation enum"  "seconds"         "cancel pulse"  "initial latch state"
Data_Type:             int               real              boolean         int
Default_Value:         0                 0                 true            0
Limits:                [0 6]             [0 -]             -               [0 1]
Vector:                no                no                no              no
Vector_Bounds:         -                 -                 -               -
Null_Allowed:          yes               yes               yes             yes

PARAMETER_TABLE:
Parameter_Name:        low               high
Description:           "lower threshold" "upper threshold"
Data_Type:             real              real
Default_Value:         2                 3
Limits:                -                 -
Vector:                no                no
Vector_Bounds:         -                 -
Null_Allowed:          yes               yes

PARAMETER_TABLE:
Parameter_Name:        inverted          rx_ic
Description:           "invert input"    "initial receiver bit"
Data_Type:             boolean           int
Default_Value:         false             0
Limits:                -                 [0 1]
Vector:                yes               yes
Vector_Bounds:         in                in
Null_Allowed:          yes               yes
