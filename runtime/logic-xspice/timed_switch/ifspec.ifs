NAME_TABLE:
Spice_Model_Name:      preprocess_timed_switch
C_Function_Name:       cm_preprocess_timed_switch
Description:           "Timed hysteretic switch with continuous log-conductance ramp"

PORT_TABLE:
Port_Name:             control            branch
Description:           "control voltage"  "resistive branch"
Direction:             in                 inout
Default_Type:          vd                 gd
Allowed_Types:         [v,vd]             [gd]
Vector:                no                 no
Vector_Bounds:         -                  -
Null_Allowed:          no                 no

PARAMETER_TABLE:
Parameter_Name:        ron                roff               vt                 vh
Description:           "on resistance"    "off resistance"   "threshold"        "half hysteresis"
Data_Type:             real               real               real               real
Default_Value:         1                  1e12               0.5                1
Limits:                [0 -]              [0 -]              -                  [0 -]
Vector:                no                 no                 no                 no
Vector_Bounds:         -                  -                  -                  -
Null_Allowed:          yes                yes                yes                yes

PARAMETER_TABLE:
Parameter_Name:        ton                toff               td_on              td_off
Description:           "rising duration"  "falling duration" "on delay"         "off delay"
Data_Type:             real               real               real               real
Default_Value:         1e-9               1e-9               0                  0
Limits:                [0 -]              [0 -]              [0 -]              [0 -]
Vector:                no                 no                 no                 no
Vector_Bounds:         -                  -                  -                  -
Null_Allowed:          yes                yes                yes                yes

PARAMETER_TABLE:
Parameter_Name:        timetol            ic
Description:           "crossing tolerance" "initial state hint"
Data_Type:             real               int
Default_Value:         10e-12             0
Limits:                [1e-15 -]          [0 1]
Vector:                no                 no
Vector_Bounds:         -                  -
Null_Allowed:          yes                yes
