NAME_TABLE:
Spice_Model_Name:      preprocess_logic_receiver
C_Function_Name:       cm_preprocess_logic_receiver
Description:           "Hysteretic binary logic receiver with zero event delay"

PORT_TABLE:
Port_Name:             in                  out
Description:           "input voltage"     "logical bit"
Direction:             in                  out
Default_Type:          v                   d
Allowed_Types:         [v,vd]              [d]
Vector:                no                  no
Vector_Bounds:         -                   -
Null_Allowed:          no                  no

PARAMETER_TABLE:
Parameter_Name:        low                high               inverted        ic
Description:           "lower threshold"  "upper threshold"  "invert logic"  "initial bit"
Data_Type:             real               real               boolean         int
Default_Value:         0.4                0.6                false           0
Limits:                -                  -                  -               [0 1]
Vector:                no                 no                 no              no
Vector_Bounds:         -                  -                  -               -
Null_Allowed:          yes                yes                yes             yes
