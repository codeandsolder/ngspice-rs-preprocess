# Independent original 1991 XSPICE real UDN special-value source oracle.
# The four signed Inf/NaN/binary64 overflow cases are generated by
# independent, genuine original d_to_real/real_gain C output drivers.
# Source event data are NEVER wired directly into the analog MNA solver:
# physical probes sample separately finite original real outputs instead.
function ab(x) { return x<0?-x:x }
function fail(s){print s > "/dev/stderr";bad=1}
function nearly(a,b,e){return ab(a-b)<=e}
function state(i,d){return substr(codes[((d==0?i:d==1?5*i+4:7*i+3)%12)+1],1,1)}
function drive(i,d){return codes[((d==0?i:d==1?5*i+4:7*i+3)%12)+1]}
function bpre(i){return state(i,1)=="0"?1.25:state(i,1)=="1"?-.75:.25}
function post(v){return -.5*(v+.375)+.125}
function en_val(i){return (i<7||i>=15)?(state(i,0)=="0"?.25:state(i,0)=="1"?2.25:1.25):0}
function probe(i){return biased_hc_probe(drive(i,0))}
function val_class(v, low, numeric) {
 low=tolower(v)
 if(low ~ /nan/)return "nan"
 if(low=="inf"||low=="+inf")return "+inf"
 if(low=="-inf")return "-inf"
 numeric=v+0
 if(numeric>9.9e307&&numeric<1.01e308)return "huge"
 return "other"
}
function expected_main(ns) {
 if(VARIANT=="overflow-first")return "+inf"
 if(VARIANT=="overflow-middle")return "huge"
 if(ns<.259999)return "+inf"
 if(VARIANT=="nan-first")return "nan"
 return "-inf"
}
function expected_meta(ns) {
 if(ns<.379999) return "zero"
 if(VARIANT=="overflow-first")return "+inf"
 if(VARIANT=="overflow-middle")return "huge"
 if(ns<.449999)return "+inf"
 if(VARIANT=="nan-first")return "nan"
 return "-inf"
}
BEGIN{
 n=split("0s 1s Us 0r 1r Ur 0z 1z Uz 0u 1u Uu",codes," ")
 if(n!=12||VARIANT !~ /^(overflow-first|overflow-middle|nan-first|nan-middle)$/){
  fail("invalid original XSPICE real nonfinite source classification");exit 1
 }
 file=0
}
FNR==1 {file++}
file<=2&&$1~/^[0-9]/{
 if(NF!=9){fail(sprintf("invalid original real special-event %s:%d NF=%d",FILENAME,FNR,NF));exit 1}
 route=file
 ns=$1*1e9
 rows[route]++
 if(ns+1e-6<last_ns[route]){
  fail(sprintf("event time nonmonotonic %s:%d",FILENAME,FNR));exit 1
 }
 current=val_class($2)
 want=expected_main(ns)
 if(current!=want){
  fail(sprintf("%s REAL_SUM wrong %s at %.8fns expected %s got %s",VARIANT,FILENAME,ns,want,current));exit 1
 }
 got_meta=val_class($3)
 want_meta=expected_meta(ns)
 if(want_meta=="zero"){
   if(!nearly($3,0,.000001)){fail(sprintf("%s R_META should be zero during original C DC init",FILENAME));exit 1}
 }else if(got_meta!=want_meta){
   fail(sprintf("%s REAL propagated via original C-model gain wrong at %.8fns expected %s got %s",FILENAME,ns,want_meta,got_meta));exit 1
 }
 for(i=0;i<24;i++){
   t=i*12
   if(!seen[route,i,"source"]&&nearly(ns,t,.0005)){
      if($7!=drive(i,0)||$8!=drive(i,1)||$9!=drive(i,2)){
        fail(sprintf("source original digital state/strength mismatch %s at %d",FILENAME,i));exit 1
      }
      seen[route,i,"source"]=1
      source_events++
   }
   if(i==0)continue
   if(!seen[route,i,"B"]&&nearly(ns,t+.3,.0005)){
      if(!nearly($4,bpre(i),.000001)){
        fail(sprintf("original BPRE source event wrong %s phase %d",FILENAME,i));exit 1
      }
      seen[route,i,"B"]=1
      real_events++
   }
   if(!seen[route,i,"POST"]&&nearly(ns,t+.48,.0005)){
      if(!nearly($5,post(bpre(i)),.000001)){
        fail(sprintf("original downstream finite real_gain event wrong %s phase %d",FILENAME,i));exit 1
      }
      seen[route,i,"POST"]=1
      real_events++
   }
 }
 if(rows[route]==1){
   if(!nearly(ns,0,1e-6)||!nearly($4,-.75,.000001)||
     !nearly($5,-1.125,.000001)||!nearly($6,.25,.000001)){
      fail(sprintf("original real nonfinite C-model DC initial condition wrong in %s",FILENAME));exit 1
   }
 }
 # The actual original C-model gain generates a finite RPOST initial
 # update at the absolute +360ps point.
 if(nearly(ns,.36,.0005)){
   if(!nearly($5,post(-.75),.000001)){
     fail(sprintf("original real finite companion gain event wrong in %s",FILENAME));exit 1
   }
   finite_dc_event[route]=1
 }
 for(j=1;j<=2;j++){
  edge=j==1?93:189
  value=j==1?0:.25
  if(!enable_seen[route,j] && ns>=edge&&ns<edge+1.2&&
     nearly($6,value,.000001)&&rows[route]>1 &&
     !nearly(before_enabled[route],$6,.000001)){
     enable_seen[route,j]=1;enable_ns[route,j]=ns
  }
 }
 before_enabled[route]=$6
 last_ns[route]=ns
 next
}
file>=3 {
 if(NF!=12||file>4){
  fail(sprintf("invalid original finite companion analog waveform %s:%d",FILENAME,FNR));exit 1
 }
 route=file-2
 ns=$1*1e9
 wave_rows[route]++
 if(wave_rows[route]==1 &&
  (!nearly($2,-.75,.000001)||!nearly($4,-1.125,.000001)||!nearly($6,.25,.000001))){
  fail(sprintf("nonfinite XSPICE original finite companion DC output wrong %s",FILENAME));exit 1
 }
 kcl=ab($10-($8-1.2)*.001)
 if(kcl>max_kcl)max_kcl=kcl
 if(kcl>1e-7){fail(sprintf("original source finite pull KCL violated %s t %.6fns",FILENAME,ns));exit 1}
 for(i=0;i<24;i++){
   sample=i*12+((i==7||i==15)?11.5:10.5)
   if(seen[route,i,"analog"]||ab(ns-sample)>.035)continue
   target[0]=bpre(i)
   target[1]=post(bpre(i))
   target[2]=en_val(i)
   target[3]=probe(i)
   actual[0]=$2;actual[1]=$4;actual[2]=$6;actual[3]=$8
   for(k=0;k<4;k++){
     error_v=ab(actual[k]-target[k])
     tolerance=(k==3&&floating_drive(drive(i,0)))?.018:(k==2&&(i==7||i==15))?.018:.005
     if(error_v>tolerance){
       fail(sprintf("%s finite original analog output changed phase %d channel %d expected %.7g got %.7g",FILENAME,i,k,target[k],actual[k]))
       exit 1
     }
     if(error_v>max_error)max_error=error_v
     analog_checks++
   }
   seen[route,i,"analog"]=1
 }
}
END{
 if(bad)exit 1
 if(file!=4||rows[1]<70||rows[2]<70||wave_rows[1]<11000||wave_rows[2]<11000)
   fail(sprintf("incomplete original C source nonfinite event/analog traces: events %d/%d, analog %d/%d",rows[1],rows[2],wave_rows[1],wave_rows[2]))
 for(route=1;route<=2;route++){
   if(!finite_dc_event[route]) fail(sprintf("missing finite downstream gain init route %d",route))
   for(i=0;i<24;i++){
     if(!seen[route,i,"source"])fail(sprintf("missing strength source phase %d route %d",i,route))
     if(!seen[route,i,"analog"])fail(sprintf("missing analog source phase %d route %d",i,route))
     if(i>0){
       if(!seen[route,i,"B"])fail(sprintf("missing BPRE event source phase %d route %d",i,route))
       if(!seen[route,i,"POST"])fail(sprintf("missing post-gain event source phase %d route %d",i,route))
     }
   }
 }
 for(j=1;j<=2;j++){
  if(!enable_seen[1,j]||!enable_seen[2,j]){
    fail(sprintf("missing actual original enable source edge %d",j));continue
  }
  reference=j==1?93.4135:189.4135
  if(!nearly(enable_ns[1,j],reference,.035))
    fail(sprintf("original C finite enable absolute timing incorrect at %.6f ns",enable_ns[1,j]))
  delay[j]=(enable_ns[2,j]-enable_ns[1,j])*1000
  if(!nearly(delay[j],200,35))
    fail(sprintf("nonfinite XSPICE original physical 2pF receiver delay wrong: %.3fps",delay[j]))
 }
 if(!bad)printf("Original XSPICE REAL nonfinite %s: %d true original state/strength events, %d finite real C-model update checks, source-resolved node %s, %d/192 actual loaded analog samples, max KCL %.3gA, receiver +%.3f/+%.3fps PASS\n",
     VARIANT,source_events,real_events,VARIANT,analog_checks,max_kcl,delay[1],delay[2])
 exit bad
}
