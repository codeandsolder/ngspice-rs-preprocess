NAME_TABLE:
Spice_Model_Name:      sr_bundle_driver
C_Function_Name:       cm_sr_bundle_driver
Description:           "ngspice-rs-preprocess digital signal bundle driver probe"

PORT_TABLE:
Port_Name:             in                  state               sink_meta           source_meta          wake
Description:           "logic input"       "logic output"      "sink metadata"     "source metadata"   "startup wake"
Direction:             in                  out                 out                 out                  in
Default_Type:          d                   d                   d                   d                    v
Allowed_Types:         [d]                 [d]                 [d]                 [d]                  [v]
Vector:                no                  no                  no                  no                   no
Vector_Bounds:         -                   -                   -                   -                    -
Null_Allowed:          no                  no                  no                  no                   no

PARAMETER_TABLE:
Parameter_Name:        delay               out_res             min_sink            max_source
Description:           "base delay"        "output resistance" "sink limit"        "source limit"
Data_Type:             real                real                real                real
Default_Value:         1e-9                0                   -1e99               1e99
Limits:                [1e-12 -]           [0 -]               -                   -
Vector:                no                  no                  no                  no
Vector_Bounds:         -                   -                   -                   -
Null_Allowed:          yes                 yes                 yes                 yes

PARAMETER_TABLE:
Parameter_Name:        ic                  inertial_delay
Description:           "initial state"     "swallow pulses"
Data_Type:             int                 boolean
Default_Value:         0                   true
Limits:                [0 2]               -
Vector:                no                  no
Vector_Bounds:         -                   -
Null_Allowed:          yes                 yes

STATIC_VAR_TABLE:
Static_Var_Name:       is_inertial         transient_wake_queued
Data_Type:             boolean             boolean
Description:           "using inertial delay" "startup event queued"
