* DAC rail order reversed-negative
.model SRC d_source(input_file="source.txt" input_load=0)
Asrc [dig] SRC
.model DAC dac_bridge(in_family="HC" out_low=-1 out_high=-2 g_pullup=.024 g_pulldown=.034 g_hiz=.001 g_resistive=.002 input_load=0 t_rise=1n t_fall=1n knee_low=-1.5 knee_high=-1.75 v_smooth=.5)
Adac dig q DAC
Vforce q 0 PWL(0 -2 80n 7 180n -2)
.PRINT TRAN I(Vforce)
.tran 2p 180n 0 2p
.end
