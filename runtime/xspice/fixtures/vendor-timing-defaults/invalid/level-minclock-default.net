* Cross-kind applicability of timing parameters: level-minclock-default
Vdata d 0 5
Vclock ck 0 PWL(0 0 9.9n 0 10n 5 10.3n 5 10.4n 0 29.9n 0 30n 5 34n 5 34.1n 0 50n 0)
.model M0 d_logic_block file=LOGIC0 family="HC" input_load=0 out_res=100
.file LOGIC0
PORT D in[0] ;
PORT CK in[1] ;
PORT Q out[0] ;
LEVEL (WIDTH=1, DELAY=2n, CLOCK=in[1]) FF=0 ;
FF=D ;
Q=FF ;
.endf
Aseq0 [d ck] [q0] M0
Rout0 q0 0 100k
.model M1 d_logic_block file=LOGIC1 family="HC" input_load=0 out_res=100 min_clock=1n
.file LOGIC1
PORT D in[0] ;
PORT CK in[1] ;
PORT Q out[0] ;
LEVEL (WIDTH=1, DELAY=2n, CLOCK=in[1]) FF=0 ;
FF=D ;
Q=FF ;
.endf
Aseq1 [d ck] [q1] M1
Rout1 q1 0 100k
.model M2 d_logic_block file=LOGIC2 family="HC" input_load=0 out_res=100
.file LOGIC2
PORT D in[0] ;
PORT CK in[1] ;
PORT Q out[0] ;
LEVEL (WIDTH=1, DELAY=2n, CLOCK=in[1], MINCLOCK=1n) FF=0 ;
FF=D ;
Q=FF ;
.endf
Aseq2 [d ck] [q2] M2
Rout2 q2 0 100k
.model M3 d_logic_block file=LOGIC3 family="HC" input_load=0 out_res=100 min_clock=1n
.file LOGIC3
PORT D in[0] ;
PORT CK in[1] ;
PORT Q out[0] ;
LEVEL (WIDTH=1, DELAY=2n, CLOCK=in[1], MINCLOCK=0) FF=0 ;
FF=D ;
Q=FF ;
.endf
Aseq3 [d ck] [q3] M3
Rout3 q3 0 100k
.tran 10p 50n 0 10p
.PRINT TRAN V(q0) V(q1) V(q2) V(q3)
.end