* Cross-kind applicability of timing parameters: level-hold-default
Vdata d 0 PWL(0 0 8n 0 8.1n 5 10.2n 5 10.3n 0 30n 0 30.1n 5 50n 5)
Vclock ck 0 PWL(0 0 5n 0 5.1n 5 9.9n 5 10n 0 25n 0 25.1n 5 43n 5 43.1n 0 50n 0)
.model M0 d_logic_block file=LOGIC0 family="HC" input_load=0 out_res=100
.file LOGIC0
PORT D in[0] ;
PORT CK in[1] ;
PORT Q out[0] ;
LEVEL (WIDTH=1, DELAY=2n, CLOCK=in[1]) FF=0 ;
FF=D ;
Q=FF ;
.endf
Aseq0 [d ck] [q0] M0
Rout0 q0 0 100k
.model M1 d_logic_block file=LOGIC1 family="HC" input_load=0 out_res=100 hold_time=1n
.file LOGIC1
PORT D in[0] ;
PORT CK in[1] ;
PORT Q out[0] ;
LEVEL (WIDTH=1, DELAY=2n, CLOCK=in[1]) FF=0 ;
FF=D ;
Q=FF ;
.endf
Aseq1 [d ck] [q1] M1
Rout1 q1 0 100k
.tran 10p 50n 0 10p
.PRINT TRAN V(q0) V(q1)
.end