* Cross-kind applicability of timing parameters: comb-defaults
Vdata d 0 PWL(0 0 9.5n 0 9.6n 5 19.9n 5 20n 0 50n 0)
Vclock ck 0 0
.model M0 d_logic_block file=LOGIC0 family="HC" input_load=0 out_res=100
.file LOGIC0
PORT D in[0] ;
PORT Q out[0] ;
COMB (WIDTH=1, DELAY=2n) FF=0 ;
FF=D ;
Q=FF ;
.endf
Aseq0 [d] [q0] M0
Rout0 q0 0 100k
.model M1 d_logic_block file=LOGIC1 family="HC" input_load=0 out_res=100 hold_time=1n min_clock=1n setup_time=1n
.file LOGIC1
PORT D in[0] ;
PORT Q out[0] ;
COMB (WIDTH=1, DELAY=2n) FF=0 ;
FF=D ;
Q=FF ;
.endf
Aseq1 [d] [q1] M1
Rout1 q1 0 100k
.tran 10p 50n 0 10p
.PRINT TRAN V(q0) V(q1)
.end