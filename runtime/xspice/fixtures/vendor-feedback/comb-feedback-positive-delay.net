* Vendor-derived COMB cascade or positive-delay feedback experiment
.model MCOMB_FEEDBACK_POSITIVE_DELAY d_logic_block file=FCOMB_FEEDBACK_POSITIVE_DELAY family="UNIV"
.file FCOMB_FEEDBACK_POSITIVE_DELAY
PORT Data in[0] ;
PORT Q out[0] ;
COMB (WIDTH=1, DELAY=1n) Osc=0 ;
Osc=!Osc ;
Q=Osc ;
.endf
Vdata d 0 PWL(0 0 12n 0)
Acomb [d] [q] MCOMB_FEEDBACK_POSITIVE_DELAY
Rout q 0 100k
.tran 20p 12n 0 20p
.PRINT TRAN V(d) V(q)
.end