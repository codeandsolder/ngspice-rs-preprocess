* 5 ps resolution Elements 9.40d edge-hold-d800ps; D0 midpoint=10.800000 ns
.model MSCALAR_0_HOLD d_logic_block file=FSCALAR_0_HOLD family="UNIV"
.file FSCALAR_0_HOLD
PORT Data in[0:1] ;
PORT Clock in[2] ;
PORT Q out[0:1] ;
EDGE (WIDTH=2, DELAY=1n, HOLD=800p, BITWISE=0, CLOCK=in[2]) R=0 ;
R=Data ;
OUT[0:1]=R ;
.endf
Vd0 d0 0 PWL(0 0 5n 0 5.1n 5 10.750000n 5 10.850000n 0 38n 0)
Vd1 d1 0 PWL(0 0 5n 0 5.1n 5 19.95n 5 20.05n 0 38n 0)
Vclock ck 0 PWL(0 0 9.95n 0 10.05n 5 14.95n 5 15.05n 0 23.95n 0 24.05n 5 28.95n 5 29.05n 0 38n 0)
Aseq [d0 d1 ck] [q0 q1] MSCALAR_0_HOLD
Rout0 q0 0 100k
Rout1 q1 0 100k
.tran 5p 38n 0 5p
.PRINT TRAN V(d0) V(d1) V(ck) V(q0) V(q1)
.end
