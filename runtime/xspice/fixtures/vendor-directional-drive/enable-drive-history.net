* DAC history probe: four combinations of prior and new binary drive across HI-Z
Vd d 0 PWL(0 0 59.9n 0 60n 5 139.9n 5 140n 0 170n 0)
Ve en 0 PWL(0 5 9.9n 5 10n 0 29.9n 0 30n 5 49.9n 5 50n 0 69.9n 0 70n 5 89.9n 5 90n 0 109.9n 0 110n 5 129.9n 5 130n 0 149.9n 0 150n 5 170n 5)
.file LOGIC
PORT D in[0] ;
PORT EN in[1] ;
PORT (DELAY=4n) Q out[0] ;
COMB (WIDTH=1, DELAY=1n) REG=0 ;
REG=D ;
Q=REG ;
Q.En=EN ;
.endf
.model M0 d_logic_block file=LOGIC family="HC" input_load=0 out_res=0
.model DAC dac_bridge(in_family="HC" out_low=0 out_high=5 g_pullup=.024 g_pulldown=.034 g_hiz=1e-9 g_resistive=.001 input_load=4p t_rise=2n t_fall=2n knee_low=2 knee_high=2.75 v_smooth=.5)
Aseq0 [d en] [dig0] M0
Adac0 dig0 q0 DAC
Vforce0 q0 0 0
Aseq1 [d en] [dig1] M0
Adac1 dig1 q1 DAC
Vforce1 q1 0 2.5
Aseq2 [d en] [dig2] M0
Adac2 dig2 q2 DAC
Vforce2 q2 0 4
.tran 5p 170n 0 5p
.PRINT TRAN I(Vforce0) I(Vforce1) I(Vforce2)
.end
