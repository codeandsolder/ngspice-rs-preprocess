* Stateful signed current fanout thresholds, hold and recovery
Vd d 0 PWL(0 0 5n 0 5.1n 5 25n 5 25.1n 0 45n 0 45.1n 5 65n 5 65.1n 0 100n 0)
Vck ck 0 PWL(0 0 9.9n 0 10n 5 13n 5 13.1n 0 29.9n 0 30n 5 33n 5 33.1n 0 49.9n 0 50n 5 53n 5 53.1n 0 69.9n 0 70n 5 73n 5 73.1n 0 100n 0)
.file LOGIC
PORT D in[0] ;
PORT CK in[1] ;
PORT (DELAY=4n) Q out[0] ;
EDGE (WIDTH=1, DELAY=1n, CLOCK=in[1]) REG=0 ;
REG=D ;
Q=REG ;
.endf
.model M0 d_logic_block file=LOGIC family="HC" input_load=0 out_res=1500
.model M1 d_logic_block file=LOGIC family="HC" input_load=0 out_res=1500 min_sink=-10m max_source=10m
.model DAC0 dac_bridge(in_family="HC" out_low=0 out_high=5 g_pullup=.024 g_pulldown=.034 g_hiz=1e-9 g_resistive=.001 input_load=4p t_rise=2n t_fall=2n knee_low=2 knee_high=2.75 v_smooth=.5 sink_current=-5m source_current=5m)
.model DAC1 dac_bridge(in_family="HC" out_low=0 out_high=5 g_pullup=.024 g_pulldown=.034 g_hiz=1e-9 g_resistive=.001 input_load=4p t_rise=2n t_fall=2n knee_low=2 knee_high=2.75 v_smooth=.5 sink_current=-10m source_current=10m)
.model DAC2 dac_bridge(in_family="HC" out_low=0 out_high=5 g_pullup=.024 g_pulldown=.034 g_hiz=1e-9 g_resistive=.001 input_load=4p t_rise=2n t_fall=2n knee_low=2 knee_high=2.75 v_smooth=.5 sink_current=-5m source_current=15m)
.model DAC3 dac_bridge(in_family="HC" out_low=0 out_high=5 g_pullup=.024 g_pulldown=.034 g_hiz=1e-9 g_resistive=.001 input_load=4p t_rise=2n t_fall=2n knee_low=2 knee_high=2.75 v_smooth=.5 sink_current=-15m source_current=5m)
Aseq0 [d ck] [dig0] M1
Adac0 dig0 q0 DAC0
Rout0 q0 0 100k
Aseq1 [d ck] [dig1] M1
Adac1 dig1 q1 DAC1
Rout1 q1 0 100k
Aseq2 [d ck] [dig2] M1
Adac2 dig2 q2 DAC2
Rout2 q2 0 100k
Aseq3 [d ck] [dig3] M1
Adac3 dig3 q3 DAC3
Rout3 q3 0 100k
.tran 5p 100n 0 5p
.PRINT TRAN V(q0) V(q1) V(q2) V(q3)
.end