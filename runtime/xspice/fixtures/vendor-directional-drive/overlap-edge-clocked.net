* Directional resistance during output enable/disable transitions
Vd d 0 PWL(0 0 30n 0 30.1n 5 80n 5 80.1n 0 120n 0)
Ve en 0 PWL(0 5 9.9n 5 10n 0 19.9n 0 20n 5 39.9n 5 40n 0 59.9n 0 60n 5 89.9n 5 90n 0 109.9n 0 110n 5 120n 5)
Vbias bias 0 2.5
Vck ck 0 PWL(0 0 30.9n 0 31n 5 34n 5 34.1n 0 80.9n 0 81n 5 84n 5 84.1n 0 120n 0)
.file LOGIC
PORT D in[0] ;
PORT EN in[1] ;
PORT CK in[2] ;
PORT (DELAY=4n) Q out[0] ;
EDGE (WIDTH=1, DELAY=1n, CLOCK=in[2]) REG=0 ;
REG=D ;
Q=REG ;
Q.En=EN ;
.endf
.model M0 d_logic_block file=LOGIC family="HC" input_load=0 out_res=0
.model M1 d_logic_block file=LOGIC family="HC" input_load=0 out_res_pos=1000 out_res_neg=2000
.model M2 d_logic_block file=LOGIC family="HC" input_load=0 out_res_pos=2000 out_res_neg=1000
.model DAC dac_bridge(in_family="HC" out_low=0 out_high=5 g_pullup=.024 g_pulldown=.034 g_hiz=1e-9 g_resistive=.001 input_load=4p t_rise=2n t_fall=2n knee_low=2 knee_high=2.75 v_smooth=.5)
Aseq0 [d en ck] [dig0] M0
Adac0 dig0 q0 DAC
Vforce0 q0 0 0
Aseq1 [d en ck] [dig1] M0
Adac1 dig1 q1 DAC
Vforce1 q1 0 2.5
Aseq2 [d en ck] [dig2] M0
Adac2 dig2 q2 DAC
Vforce2 q2 0 5
Aseq3 [d en ck] [dig3] M1
Adac3 dig3 q3 DAC
Vforce3 q3 0 0
Aseq4 [d en ck] [dig4] M1
Adac4 dig4 q4 DAC
Vforce4 q4 0 2.5
Aseq5 [d en ck] [dig5] M1
Adac5 dig5 q5 DAC
Vforce5 q5 0 5
Aseq6 [d en ck] [dig6] M2
Adac6 dig6 q6 DAC
Vforce6 q6 0 0
Aseq7 [d en ck] [dig7] M2
Adac7 dig7 q7 DAC
Vforce7 q7 0 2.5
Aseq8 [d en ck] [dig8] M2
Adac8 dig8 q8 DAC
Vforce8 q8 0 5
.tran 5p 120n 0 5p
.PRINT TRAN I(Vforce0) I(Vforce1) I(Vforce2) I(Vforce3) I(Vforce4) I(Vforce5) I(Vforce6) I(Vforce7) I(Vforce8)
.end
