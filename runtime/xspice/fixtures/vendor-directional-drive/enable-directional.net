* Directional resistance during output enable/disable transitions
Vd d 0 PWL(0 0 30n 0 30.1n 5 80n 5 80.1n 0 120n 0)
Ve en 0 PWL(0 5 9.9n 5 10n 0 19.9n 0 20n 5 39.9n 5 40n 0 59.9n 0 60n 5 89.9n 5 90n 0 109.9n 0 110n 5 120n 5)
Vbias bias 0 2.5
.file LOGIC
PORT D in[0] ;
PORT EN in[1] ;
PORT (DELAY=4n) Q out[0] ;
COMB (WIDTH=1, DELAY=1n) REG=0 ;
REG=D ;
Q=REG ;
Q.En=EN ;
.endf
.model M0 d_logic_block file=LOGIC family="HC" input_load=0 out_res=0
.model M1 d_logic_block file=LOGIC family="HC" input_load=0 out_res_pos=1000 out_res_neg=2000
.model M2 d_logic_block file=LOGIC family="HC" input_load=0 out_res_pos=2000 out_res_neg=1000
.model DAC dac_bridge(in_family="HC" out_low=0 out_high=5 g_pullup=.024 g_pulldown=.034 g_hiz=1e-9 g_resistive=.001 input_load=4p t_rise=2n t_fall=2n knee_low=2 knee_high=2.75 v_smooth=.5)
Aseq0 [d en] [dig0] M0
Adac0 dig0 q0 DAC
Rout0 q0 bias 1k
Aseq1 [d en] [dig1] M1
Adac1 dig1 q1 DAC
Rout1 q1 bias 1k
Aseq2 [d en] [dig2] M2
Adac2 dig2 q2 DAC
Rout2 q2 bias 1k
.tran 5p 120n 0 5p
.PRINT TRAN V(q0) V(q1) V(q2)
.end