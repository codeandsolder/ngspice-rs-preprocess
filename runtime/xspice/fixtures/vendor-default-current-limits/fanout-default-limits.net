* Original aggregate and directional current-limit controls
Vinput d 0 PULSE(0 5 2n 1n 1n 5n 15n)
.model DRV1 d_logic_block family="HC" vsupply=5 input_load=0 out_res=40 out_delay=1n  def="out[0]=in[0];"
Aprod1 [d] [p1] DRV1
 .model RCV1_1 d_logic_block family="HC" vsupply=5 input_load=2p out_res=40 out_delay=1n sink_current=-.5m source_current=.5m def="out[0]=in[0];"
Acons1_1 [p1] [q1_1] RCV1_1
Rload1_1 q1_1 0 100k
 .model RCV1_2 d_logic_block family="HC" vsupply=5 input_load=2p out_res=40 out_delay=1n sink_current=-.5m source_current=.5m def="out[0]=in[0];"
Acons1_2 [p1] [q1_2] RCV1_2
Rload1_2 q1_2 0 100k
.model DRV2 d_logic_block family="HC" vsupply=5 input_load=0 out_res=40 out_delay=1n  def="out[0]=in[0];"
Aprod2 [d] [p2] DRV2
 .model RCV2_1 d_logic_block family="HC" vsupply=5 input_load=2p out_res=40 out_delay=1n sink_current=-.5m source_current=.5m def="out[0]=in[0];"
Acons2_1 [p2] [q2_1] RCV2_1
Rload2_1 q2_1 0 100k
 .model RCV2_2 d_logic_block family="HC" vsupply=5 input_load=2p out_res=40 out_delay=1n sink_current=-.501m source_current=.501m def="out[0]=in[0];"
Acons2_2 [p2] [q2_2] RCV2_2
Rload2_2 q2_2 0 100k
.model DRV3 d_logic_block family="HC" vsupply=5 input_load=0 out_res=40 out_delay=1n  def="out[0]=in[0];"
Aprod3 [d] [p3] DRV3
 .model RCV3_1 d_logic_block family="HC" vsupply=5 input_load=2p out_res=40 out_delay=1n sink_current=-1.5m source_current=1.5m def="out[0]=in[0];"
Acons3_1 [p3] [q3_1] RCV3_1
Rload3_1 q3_1 0 100k
 .model RCV3_2 d_logic_block family="HC" vsupply=5 input_load=2p out_res=40 out_delay=1n sink_current=.5m source_current=-.5m def="out[0]=in[0];"
Acons3_2 [p3] [q3_2] RCV3_2
Rload3_2 q3_2 0 100k
.model DRV4 d_logic_block family="HC" vsupply=5 input_load=0 out_res=40 out_delay=1n max_source=2m def="out[0]=in[0];"
Aprod4 [d] [p4] DRV4
 .model RCV4_1 d_logic_block family="HC" vsupply=5 input_load=2p out_res=40 out_delay=1n sink_current=-.501m source_current=1m def="out[0]=in[0];"
Acons4_1 [p4] [q4_1] RCV4_1
Rload4_1 q4_1 0 100k
 .model RCV4_2 d_logic_block family="HC" vsupply=5 input_load=2p out_res=40 out_delay=1n sink_current=-.5m source_current=1m def="out[0]=in[0];"
Acons4_2 [p4] [q4_2] RCV4_2
Rload4_2 q4_2 0 100k
.model DRV5 d_logic_block family="HC" vsupply=5 input_load=0 out_res=40 out_delay=1n min_sink=-2m def="out[0]=in[0];"
Aprod5 [d] [p5] DRV5
 .model RCV5_1 d_logic_block family="HC" vsupply=5 input_load=2p out_res=40 out_delay=1n sink_current=-1m source_current=.501m def="out[0]=in[0];"
Acons5_1 [p5] [q5_1] RCV5_1
Rload5_1 q5_1 0 100k
 .model RCV5_2 d_logic_block family="HC" vsupply=5 input_load=2p out_res=40 out_delay=1n sink_current=-1m source_current=.5m def="out[0]=in[0];"
Acons5_2 [p5] [q5_2] RCV5_2
Rload5_2 q5_2 0 100k
.model DRV6 d_logic_block family="HC" vsupply=5 input_load=0 out_res=40 out_delay=1n min_sink=0 max_source=0 def="out[0]=in[0];"
Aprod6 [d] [p6] DRV6
 .model RCV6_1 d_logic_block family="HC" vsupply=5 input_load=2p out_res=40 out_delay=1n sink_current=0 source_current=0 def="out[0]=in[0];"
Acons6_1 [p6] [q6_1] RCV6_1
Rload6_1 q6_1 0 100k
 .model RCV6_2 d_logic_block family="HC" vsupply=5 input_load=2p out_res=40 out_delay=1n sink_current=0 source_current=0 def="out[0]=in[0];"
Acons6_2 [p6] [q6_2] RCV6_2
Rload6_2 q6_2 0 100k
.model DRV7 d_logic_block family="HC" vsupply=5 input_load=0 out_res=40 out_delay=1n min_sink=0 max_source=0 def="out[0]=in[0];"
Aprod7 [d] [p7] DRV7
 .model RCV7_1 d_logic_block family="HC" vsupply=5 input_load=2p out_res=40 out_delay=1n sink_current=-1u source_current=1u def="out[0]=in[0];"
Acons7_1 [p7] [q7_1] RCV7_1
Rload7_1 q7_1 0 100k
 .model RCV7_2 d_logic_block family="HC" vsupply=5 input_load=2p out_res=40 out_delay=1n sink_current=0 source_current=0 def="out[0]=in[0];"
Acons7_2 [p7] [q7_2] RCV7_2
Rload7_2 q7_2 0 100k
.model DRV8 d_logic_block family="HC" vsupply=5 input_load=0 out_res=40 out_delay=1n  def="out[0]=in[0];"
Aprod8 [d] [p8] DRV8
 .model RCV8_1 d_logic_block family="HC" vsupply=5 input_load=2p out_res=40 out_delay=1n sink_current=-.3m source_current=.3m def="out[0]=in[0];"
Acons8_1 [p8] [q8_1] RCV8_1
Rload8_1 q8_1 0 100k
 .model RCV8_2 d_logic_block family="HC" vsupply=5 input_load=2p out_res=40 out_delay=1n sink_current=-.3m source_current=.3m def="out[0]=in[0];"
Acons8_2 [p8] [q8_2] RCV8_2
Rload8_2 q8_2 0 100k
 .model RCV8_3 d_logic_block family="HC" vsupply=5 input_load=2p out_res=40 out_delay=1n sink_current=-.4m source_current=.4m def="out[0]=in[0];"
Acons8_3 [p8] [q8_3] RCV8_3
Rload8_3 q8_3 0 100k
.PRINT TRAN V(q1_1) V(q1_2) V(q2_1) V(q2_2) V(q3_1) V(q3_2) V(q4_1) V(q4_2) V(q5_1) V(q5_2) V(q6_1) V(q6_2) V(q7_1) V(q7_2) V(q8_1) V(q8_2) V(q8_3)
.tran 5p 20n 0 5p
.end
