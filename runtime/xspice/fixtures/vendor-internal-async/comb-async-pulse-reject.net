* Original authored SIMetrix 9.40d internal COMB -> asynchronous EDGE oracle
.model MCOMB_ASYNC_PULSE_REJECT d_logic_block file=FCOMB_ASYNC_PULSE_REJECT family="UNIV"
.file FCOMB_ASYNC_PULSE_REJECT
PORT Data in[0] ;
PORT Clock in[1] ;
PORT Reset in[2] ;
PORT Q out[0] ;
COMB (WIDTH=1, DELAY=1n) ResetPipe=0 ;
EDGE (WIDTH=1, DELAY=2n, ASYNCDELAY=300p, CLOCK=in[1]) Flip=0 ;
ResetPipe = Reset ;
Flip := !ResetPipe ? 0 ;
Flip = Data ;
Q = Flip ;
.endf
Vdata d 0 PWL(0 0 5n 0 5.1n 5 52n 5)
Vclock ck 0 PWL(0 0 9.9n 0 10n 5 12n 5 12.1n 0 29.9n 0 30n 5 32n 5 32.1n 0 52n 0)
Vreset rst 0 PWL(0 5 14.9n 5 15n 0 15.1n 0 15.2n 5 52n 5)
Aseq [d ck rst] [q] MCOMB_ASYNC_PULSE_REJECT
Rout q 0 100k
.tran 20p 52n 0 20p
.PRINT TRAN V(d) V(ck) V(rst) V(q)
.end
