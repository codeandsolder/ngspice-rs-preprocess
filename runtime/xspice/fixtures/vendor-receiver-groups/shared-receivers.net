* Shared physical input, heterogeneous HC supply groups across hierarchy
Vinput p 0 PWL(0 0 10n 0 50n 5 60n 5 100n 0 110n 0)
Xone p q1 q2 q3 WRAP
Xtwo p q4 q5 q6 WRAP
Aroot [p] [q7] M5
.model M5 d_logic_block family="HC" vsupply=5 input_load=2p sink_current=-1m source_current=2m out_res=40 out_delay=1n def="out[0]=in[0];"
.subckt WRAP p a b c
Xnested p a b INNER
A3 [p] [c] M10
.model M10 d_logic_block family="HC" vsupply=10 input_load=3p sink_current=-2m source_current=3m out_res=40 out_delay=1n def="out[0]=in[0];"
.ends WRAP
.subckt INNER p a b
A1 [p] [a] M33
A2 [p] [b] M5
.model M33 d_logic_block family="HC" vsupply=3.3 input_load=1p sink_current=-.5m source_current=1m out_res=40 out_delay=1n def="out[0]=in[0];"
.ends INNER
R1 q1 0 100k
R2 q2 0 100k
R3 q3 0 100k
R4 q4 0 100k
R5 q5 0 100k
R6 q6 0 100k
R7 q7 0 100k
.tran 5p 110n 0 5p
.PRINT TRAN V(q1) V(q2) V(q3) V(q4) V(q5) V(q6) V(q7) I(Vinput)
.end
