* SIMetrix Elements 9.40d original-source USER/DEVICE runtime parameter oracle
.model MUSER_SCALED d_logic_block file=FUSER_SCALED family="UNIV" user=[500p] user_scale=2
.file FUSER_SCALED
PORT Data in[0] ;
PORT Q out[0] ;
COMB (WIDTH=1, DELAY=USER[0], BITWISE=1) Stage=0 ;
Stage=Data ;
Q=Stage ;
.endf
Vdata d 0 PWL(0 0 5n 0 5.1n 5 5.4n 5 5.5n 0 10n 0 10.1n 5 14n 5 14.1n 0 42n 0)
Aalb [d] [q] MUSER_SCALED
Rout q 0 100k
.tran 20p 42n 0 20p
.PRINT TRAN V(d) V(q)
.end