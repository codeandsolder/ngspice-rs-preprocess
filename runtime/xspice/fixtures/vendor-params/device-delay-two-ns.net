* SIMetrix Elements 9.40d original-source USER/DEVICE runtime parameter oracle
.model MDEVICE_DELAY_TWO_NS d_logic_block file=FDEVICE_DELAY_TWO_NS family="UNIV"
.file FDEVICE_DELAY_TWO_NS
PORT Data in[0] ;
PORT Q out[0] ;
COMB (WIDTH=1, DELAY=DEVICE[0], BITWISE=DEVICE[1]) Stage=0 ;
Stage=Data ;
Q=Stage ;
.endf
Vdata d 0 PWL(0 0 5n 0 5.1n 5 5.4n 5 5.5n 0 10n 0 10.1n 5 14n 5 14.1n 0 42n 0)
Aalb [d] [q] MDEVICE_DELAY_TWO_NS : USER=[2n 1]
Rout q 0 100k
.tran 20p 42n 0 20p
.PRINT TRAN V(d) V(q)
.end