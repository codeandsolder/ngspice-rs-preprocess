* Original signed driver bound controls
Vinput d 0 PULSE(0 5 2n 1n 1n 5n 15n)
.model DRV d_logic_block family="HC" vsupply=5 input_load=2p out_res=40 out_delay=1n min_sink=.5m def="out[0]=in[0];"
Aprod1 [d] [p1] DRV
.model RCV1 d_logic_block family="HC" vsupply=5 input_load=2p out_res=40 out_delay=1n sink_current=0 source_current=0 def="out[0]=in[0];"
Acons1 [p1] [q1] RCV1
Rload1 q1 0 100k
Aprod2 [d] [p2] DRV
.model RCV2 d_logic_block family="HC" vsupply=5 input_load=2p out_res=40 out_delay=1n sink_current=.5m source_current=0 def="out[0]=in[0];"
Acons2 [p2] [q2] RCV2
Rload2 q2 0 100k
Aprod3 [d] [p3] DRV
.model RCV3 d_logic_block family="HC" vsupply=5 input_load=2p out_res=40 out_delay=1n sink_current=.501m source_current=0 def="out[0]=in[0];"
Acons3 [p3] [q3] RCV3
Rload3 q3 0 100k
Aprod4 [d] [p4] DRV
.model RCV4 d_logic_block family="HC" vsupply=5 input_load=2p out_res=40 out_delay=1n sink_current=-.5m source_current=0 def="out[0]=in[0];"
Acons4 [p4] [q4] RCV4
Rload4 q4 0 100k
.PRINT TRAN V(q1) V(q2) V(q3) V(q4)
.tran 5p 20n 0 5p
.end
