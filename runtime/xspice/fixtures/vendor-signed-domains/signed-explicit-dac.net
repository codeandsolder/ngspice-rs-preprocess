* Signed explicit DAC metadata and ALB contribution cancellation
Vinput d 0 PULSE(0 5 2n 1n 1n 5n 15n)
.model DRV d_logic_block family="HC" input_load=0 out_res=40 out_delay=1n def="out[0]=in[0];"
.model RCV d_logic_block family="HC" input_load=2p out_res=40 out_delay=1n sink_current=-1.5m source_current=1.5m def="out[0]=in[0];"
.model DAC dac_bridge(in_family="HC" out_low=0 out_high=5 g_pullup=.024 g_pulldown=.034 g_hiz=1e-9 g_resistive=.001 input_load=0 t_rise=2n t_fall=2n knee_low=2 knee_high=2.75 v_smooth=.5 sink_current=.5m source_current=-.5m)
Aprod [d] [p] DRV
Acons [p] [q] RCV
Adac p z DAC
Rload q 0 100k
Rz z 0 100k
.PRINT TRAN V(q) V(z)
.tran 5p 20n 0 5p
.end
