* Subpicosecond synchronous and asynchronous timing boundary
Vd d 0 PWL(0 0 .5n 0 .6n 5 7n 5)
Vc ck 0 PWL(0 0 1n 0 1.1n 5 2n 5 2.1n 0 7n 0)
Vr rst 0 PWL(0 0 3n 0 3.1n 5 7n 5)
.model M0 d_logic_block file=L0 family="HC" input_load=0 out_res=0 out_delay=1n
.file L0
PORT D in[0] ;
PORT CK in[1] ;
PORT Reset in[2] ;
PORT Q out[0] ;
EDGE (WIDTH=1,DELAY=0,CLOCK=in[1],ASYNCDELAY=0) R=0 ;
R := Reset ? 0 ;
R = D ;
Q = R ;
.endf
A0 [d ck rst] [q0] M0
R0 q0 0 100k
.model M1 d_logic_block file=L1 family="HC" input_load=0 out_res=0 out_delay=1n
.file L1
PORT D in[0] ;
PORT CK in[1] ;
PORT Reset in[2] ;
PORT Q out[0] ;
EDGE (WIDTH=1,DELAY=.2p,CLOCK=in[1],ASYNCDELAY=.2p) R=0 ;
R := Reset ? 0 ;
R = D ;
Q = R ;
.endf
A1 [d ck rst] [q1] M1
R1 q1 0 100k
