* Stateful PORT and model timing delay domain, no analog bridge load versus positive 2pF
Vd d 0 PWL(0 0 0.9n 0 1n 5 8n 5 8.1n 0 16n 0)
Vck ck 0 PWL(0 0 1.9n 0 2n 5 3n 5 3.1n 0 9.9n 0 10n 5 11n 5 11.1n 0 16n 0)
.file logic_model0
PORT D in[0];
PORT CK in[1];
PORT Q out[0];
EDGE (WIDTH=1,DELAY=1n,CLOCK=in[1]) R=0;
R=D;
Q=R;
.endf
.model Mmodel0 d_logic_block file=logic_model0 family="HC" input_load=0 out_res=1000 out_delay=-1n
Amodel0_0 [d ck] [digmodel0_0] Mmodel0
Adacmodel0_0 digmodel0_0 qmodel0_0 DAC0
Rmodel0_0 qmodel0_0 0 100k
Amodel0_1 [d ck] [digmodel0_1] Mmodel0
Adacmodel0_1 digmodel0_1 qmodel0_1 DAC1
Rmodel0_1 qmodel0_1 0 100k
.file logic_model1
PORT D in[0];
