.model DAC0 dac_bridge(in_family="HC" out_low=0 out_high=5 g_pullup=.024 g_pulldown=.034 g_hiz=1e-9 g_resistive=.001 input_load=0 t_rise=2n t_fall=2n knee_low=2 knee_high=2.75 v_smooth=.5)
.model DAC1 dac_bridge(in_family="HC" out_low=0 out_high=5 g_pullup=.024 g_pulldown=.034 g_hiz=1e-9 g_resistive=.001 input_load=2p t_rise=2n t_fall=2n knee_low=2 knee_high=2.75 v_smooth=.5)
.PRINT TRAN V(qmodel0_0) V(qmodel0_1) V(qmodel1_0) V(qmodel1_1) V(qmodel2_0) V(qmodel2_1) V(qmodel3_0) V(qmodel3_1) V(qmodel4_0) V(qmodel4_1) V(qport0_0) V(qport0_1) V(qport1_0) V(qport1_1) V(qport2_0) V(qport2_1) V(qport3_0) V(qport3_1) V(qport4_0) V(qport4_1)
.tran 0.5p 16n 0 0.5p
.end
