* Fine output delay domain: independent physical DAC outputs with zero timing resistance
Vd d 0 PULSE(0 5 1n 1n 1n 2n 20n)
.model M0 d_logic_block family="HC" input_load=0 out_res=0 out_delay=-1n def="out[0]=in[0];"
A0 [d] [q0] M0
R0 q0 0 100k
.model M1 d_logic_block family="HC" input_load=0 out_res=0 out_delay=-2p def="out[0]=in[0];"
A1 [d] [q1] M1
R1 q1 0 100k
.model M2 d_logic_block family="HC" input_load=0 out_res=0 out_delay=0 def="out[0]=in[0];"
A2 [d] [q2] M2
R2 q2 0 100k
.model M3 d_logic_block family="HC" input_load=0 out_res=0 out_delay=.5p def="out[0]=in[0];"
A3 [d] [q3] M3
R3 q3 0 100k
.model M4 d_logic_block family="HC" input_load=0 out_res=0 out_delay=1p def="out[0]=in[0];"
A4 [d] [q4] M4
R4 q4 0 100k
.model M5 d_logic_block family="HC" input_load=0 out_res=0 out_delay=2p def="out[0]=in[0];"
A5 [d] [q5] M5
R5 q5 0 100k
.model M6 d_logic_block family="HC" input_load=0 out_res=0 out_delay=5p def="out[0]=in[0];"
A6 [d] [q6] M6
R6 q6 0 100k
.PRINT TRAN V(q0) V(q1) V(q2) V(q3) V(q4) V(q5) V(q6)
.tran 0.2p 8n 0 0.2p
.end
