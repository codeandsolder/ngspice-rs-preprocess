* Explicit asynchronous delay independently of nominal register delay
Vd d 0 PWL(0 0 1n 0 1.1n 5 40n 5)
Vc ck 0 PWL(0 0 2n 0 2.1n 5 4n 5 4.1n 0 20n 0 20.1n 5 22n 5 22.1n 0 40n 0)
Vr rst 0 PWL(0 0 8n 0 8.1n 5 16n 5 16.1n 0 25n 0 25.1n 5 40n 5)
.model M0 d_logic_block file=L0 family="HC" input_load=0 out_res=0 out_delay=1n
.file L0
PORT D in[0];
PORT CK in[1];
PORT Reset in[2] ;
PORT Q out[0];
EDGE (WIDTH=1,DELAY=2n,CLOCK=in[1]) R=0;
R := Reset ? 0 ;
R = D ;
Q=R;
.endf
A0 [d ck rst] [q0] M0
R0 q0 0 100k
.model M1 d_logic_block file=L1 family="HC" input_load=0 out_res=0 out_delay=1n
.file L1
PORT D in[0];
PORT CK in[1];
PORT Reset in[2] ;
PORT Q out[0];
EDGE (WIDTH=1,DELAY=2n,CLOCK=in[1],ASYNCDELAY=0) R=0;
R := Reset ? 0 ;
R = D ;
Q=R;
.endf
A1 [d ck rst] [q1] M1
R1 q1 0 100k
.model M2 d_logic_block file=L2 family="HC" input_load=0 out_res=0 out_delay=1n
.file L2
PORT D in[0];
PORT CK in[1];
PORT Reset in[2] ;
PORT Q out[0];
EDGE (WIDTH=1,DELAY=2n,CLOCK=in[1],ASYNCDELAY=.5p) R=0;
R := Reset ? 0 ;
R = D ;
Q=R;
.endf
A2 [d ck rst] [q2] M2
R2 q2 0 100k
