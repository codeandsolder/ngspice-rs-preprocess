* Register timing domain: user-scale-negative
Vd d 0 PWL(0 0 1n 0 1.1n 5 8n 5 8.1n 0 16n 0)
Vc ck 0 PWL(0 0 2n 0 2.1n 5 4n 5 4.1n 0 10n 0 10.1n 5 12n 5 12.1n 0 16n 0)
.model M d_logic_block file=LOGIC family="HC" input_load=0 out_res=0 out_delay=1n user_scale=-1 user=[-2n]
.file LOGIC
PORT D in[0];
PORT CK in[1];
PORT Q out[0];
EDGE (WIDTH=1,DELAY=USER[0],CLOCK=in[1]) R=0;
R=D;
Q=R;
.endf
A1 [d ck] [q] M
R1 q 0 100k
.PRINT TRAN V(q)
.tran 2p 16n 0 2p
.end
