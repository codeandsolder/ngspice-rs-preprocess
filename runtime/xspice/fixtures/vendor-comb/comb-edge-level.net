* Original-source SIMetrix Elements 9.40d COMB differential probe
.model MCOMB_EDGE_LEVEL d_logic_block file=FCOMB_EDGE_LEVEL family="UNIV"
.file FCOMB_EDGE_LEVEL
PORT Data in[0:1] ;
PORT Clock in[2] ;
PORT Enable in[3] ;
PORT Q out[0:1] ;
COMB (WIDTH=2, DELAY=1n) Filter=0 ;
EDGE (WIDTH=2, DELAY=1n, CLOCK=in[2]) Capture=0 ;
LEVEL (WIDTH=2, DELAY=1n, CLOCK=in[3]) Output=0 ;
Filter=Data ;
Capture=Filter ;
Output=Capture ;
Q=Output ;
.endf
Vd0 d0 0 PWL(0 0 5n 0 5.1n 5 20n 5 20.1n 0 42n 0)
Vd1 d1 0 PWL(0 0 20n 0 20.1n 5 42n 5)
Vclock ck 0 PWL(0 0 9.9n 0 10n 5 12n 5 12.1n 0 25.9n 0 26n 5 28n 5 28.1n 0 42n 0)
Venable en 0 PWL(0 0 8.9n 0 9n 5 42n 5)
Acomb [d0 d1 ck en] [q0 q1] MCOMB_EDGE_LEVEL
Rout0 q0 0 100k
Rout1 q1 0 100k
.tran 20p 42n 0 20p
.PRINT TRAN V(d0) V(d1) V(ck) V(en) V(q0) V(q1)
.end