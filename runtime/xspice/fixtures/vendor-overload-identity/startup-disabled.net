* Initial disabled ALB drive memory across current limits
Vd0 d0 0 0
Vd1 d1 0 5
Vdr dr 0 PWL(0 0 9.9n 0 10n 5 40n 5)
Vdf df 0 PWL(0 5 9.9n 5 10n 0 40n 0)
Ve en 0 PWL(0 0 19.9n 0 20n 5 40n 5)
.file DIRECT
PORT D in[0] ;
PORT EN in[1] ;
PORT (DELAY=4n) Q out[0] ;
Q=D ;
Q.En=EN ;
.endf
.model M d_logic_block file=DIRECT family="HC" input_load=0 out_res_pos=1000 out_res_neg=2000 min_sink=-10m max_source=10m
.model DAC0 dac_bridge(in_family="HC" out_low=0 out_high=5 g_pullup=.024 g_pulldown=.034 g_hiz=1e-9 g_resistive=.001 input_load=4p t_rise=2n t_fall=2n knee_low=2 knee_high=2.75 v_smooth=.5 sink_current=-5m source_current=5m)
.model DAC1 dac_bridge(in_family="HC" out_low=0 out_high=5 g_pullup=.024 g_pulldown=.034 g_hiz=1e-9 g_resistive=.001 input_load=4p t_rise=2n t_fall=2n knee_low=2 knee_high=2.75 v_smooth=.5 sink_current=-15m source_current=5m)
.model DAC2 dac_bridge(in_family="HC" out_low=0 out_high=5 g_pullup=.024 g_pulldown=.034 g_hiz=1e-9 g_resistive=.001 input_load=4p t_rise=2n t_fall=2n knee_low=2 knee_high=2.75 v_smooth=.5 sink_current=-5m source_current=15m)
.model DAC3 dac_bridge(in_family="HC" out_low=0 out_high=5 g_pullup=.024 g_pulldown=.034 g_hiz=1e-9 g_resistive=.001 input_load=4p t_rise=2n t_fall=2n knee_low=2 knee_high=2.75 v_smooth=.5 sink_current=-15m source_current=15m)
