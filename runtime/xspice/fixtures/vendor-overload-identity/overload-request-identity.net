* Overload inertial request identity: direct and actual EDGE control
Vd d 0 PWL(0 5 24.9n 5 25n 0 94.9n 0 95n 5 140n 5)
Vhold dh 0 5
Ve en 0 PWL(0 0 19.9n 0 20n 5 69.9n 5 70n 0 89.9n 0 90n 5 101.9n 5 102n 0 140n 0)
Vc ck 0 PWL(0 0 25.4n 0 25.5n 5 28n 5 28.1n 0 95.4n 0 95.5n 5 98n 5 98.1n 0 140n 0)
.file DIRECT
PORT D in[0] ;
PORT EN in[1] ;
PORT (DELAY=4n) Q out[0] ;
Q=D ;
Q.En=EN ;
.endf
.file CLOCKED
PORT D in[0] ;
PORT EN in[1] ;
PORT CK in[2] ;
PORT (DELAY=4n) Q out[0] ;
EDGE (WIDTH=1, DELAY=1n, CLOCK=in[2]) REG=1 ;
REG=D ;
Q=REG ;
Q.En=EN ;
.endf
.model MD d_logic_block file=DIRECT family="HC" input_load=0 out_res_pos=1000 out_res_neg=2000 min_sink=-10m max_source=10m
.model MC d_logic_block file=CLOCKED family="HC" input_load=0 out_res_pos=1000 out_res_neg=2000 min_sink=-10m max_source=10m
.model DAC dac_bridge(in_family="HC" out_low=0 out_high=5 g_pullup=.024 g_pulldown=.034 g_hiz=1e-9 g_resistive=.001 input_load=4p t_rise=2n t_fall=2n knee_low=2 knee_high=2.75 v_smooth=.5 sink_current=-15m source_current=15m)
Aseq0 [d en] [dig0] MD
Adac0 dig0 q0 DAC
Vforce0 q0 0 0
Aseq1 [d en] [dig1] MD
Adac1 dig1 q1 DAC
Vforce1 q1 0 2.5
Aseq2 [d en] [dig2] MD
Adac2 dig2 q2 DAC
Vforce2 q2 0 5
Aseq3 [dh en] [dig3] MD
Adac3 dig3 q3 DAC
Vforce3 q3 0 0
Aseq4 [dh en] [dig4] MD
Adac4 dig4 q4 DAC
Vforce4 q4 0 2.5
Aseq5 [dh en] [dig5] MD
Adac5 dig5 q5 DAC
Vforce5 q5 0 5
Aseq6 [d en ck] [dig6] MC
Adac6 dig6 q6 DAC
Vforce6 q6 0 0
Aseq7 [d en ck] [dig7] MC
Adac7 dig7 q7 DAC
Vforce7 q7 0 2.5
Aseq8 [d en ck] [dig8] MC
Adac8 dig8 q8 DAC
Vforce8 q8 0 5
Aseq9 [dh en ck] [dig9] MC
Adac9 dig9 q9 DAC
Vforce9 q9 0 0
Aseq10 [dh en ck] [dig10] MC
Adac10 dig10 q10 DAC
Vforce10 q10 0 2.5
Aseq11 [dh en ck] [dig11] MC
Adac11 dig11 q11 DAC
Vforce11 q11 0 5
.tran 5p 140n 0 5p
.PRINT TRAN I(Vforce0) I(Vforce1) I(Vforce2) I(Vforce3) I(Vforce4) I(Vforce5) I(Vforce6) I(Vforce7) I(Vforce8) I(Vforce9) I(Vforce10) I(Vforce11)
.end
