* Inline DEF parameter ordering controls
.file LOGIC
PORT D in[0];
PORT Q out[0];
Q=D;
.endf
Vin2 in2 0 PWL(0 0 10n 0 50n 5 60n 5)
A2 [in2] [q2] M2
.model M2 d_logic_block family="HC" def="out[0]=in[0];" vsupply=3.3 input_load=2p sink_current=-1m source_current=2m out_res=40 out_delay=1n
R2 q2 0 100k
.tran 5p 60n 0 5p
.PRINT TRAN V(q2) I(Vin2)
.end
