* Inline DEF parameter ordering controls
.file LOGIC
PORT D in[0];
PORT Q out[0];
Q=D;
.endf
Vin4 in4 0 PWL(0 0 10n 0 50n 5 60n 5)
A4 [in4] [q4] M4
.model M4 d_logic_block family="HC" vsupply=3.3 def="out[0]=in[0];"
+ input_load=2p sink_current=-1m source_current=2m out_res=40 out_delay=1n
R4 q4 0 100k
.tran 5p 60n 0 5p
.PRINT TRAN V(q4) I(Vin4)
.end
