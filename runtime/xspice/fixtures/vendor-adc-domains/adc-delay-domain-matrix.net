.model ADC10 adc_bridge(in_low=2.1 in_high=2.2 rise_delay=1n fall_delay=1n time_tol=1p out_low=0 out_high=5 clamp_low=0 clamp_high=5 clamp_res=10 clamp_bias=.5 out_family="HC")
