* ADC event delay and tolerance domain at 0.2ps resolution
Vd d 0 PWL(0 0 .5n 0 1n 5 3n 5 3.5n 0 5n 0)
.model ADC0 adc_bridge(in_low=2.1 in_high=2.2 rise_delay=-1n fall_delay=-1n time_tol=1p out_low=0 out_high=5 clamp_low=0 clamp_high=5 clamp_res=10 clamp_bias=.5 out_family="HC")
Aadc0 d dig0 ADC0
Adac0 dig0 q0 DAC
R0 q0 0 100k
.model ADC1 adc_bridge(in_low=2.1 in_high=2.2 rise_delay=-1p fall_delay=-1p time_tol=1p out_low=0 out_high=5 clamp_low=0 clamp_high=5 clamp_res=10 clamp_bias=.5 out_family="HC")
Aadc1 d dig1 ADC1
Adac1 dig1 q1 DAC
R1 q1 0 100k
.model ADC2 adc_bridge(in_low=2.1 in_high=2.2 rise_delay=0 fall_delay=0 time_tol=1p out_low=0 out_high=5 clamp_low=0 clamp_high=5 clamp_res=10 clamp_bias=.5 out_family="HC")
Aadc2 d dig2 ADC2
Adac2 dig2 q2 DAC
R2 q2 0 100k
.model ADC3 adc_bridge(in_low=2.1 in_high=2.2 rise_delay=.5p fall_delay=.5p time_tol=1p out_low=0 out_high=5 clamp_low=0 clamp_high=5 clamp_res=10 clamp_bias=.5 out_family="HC")
Aadc3 d dig3 ADC3
Adac3 dig3 q3 DAC
R3 q3 0 100k
