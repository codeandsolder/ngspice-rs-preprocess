.model ADC11 adc_bridge(in_low=2.1 in_high=2.2 rise_delay=1n fall_delay=1n time_tol=2p out_low=0 out_high=5 clamp_low=0 clamp_high=5 clamp_res=10 clamp_bias=.5 out_family="HC")
Aadc11 d dig11 ADC11
Adac11 dig11 q11 DAC
R11 q11 0 100k
.model DAC dac_bridge(in_family="HC" out_low=0 out_high=5 g_pullup=.024 g_pulldown=.034 g_hiz=1e-9 g_resistive=.001 input_load=0 t_rise=10p t_fall=10p knee_low=2 knee_high=2.75 v_smooth=.5)
.PRINT TRAN V(q0) V(q1) V(q2) V(q3) V(q4) V(q5) V(q6) V(q7) V(q8) V(q9) V(q10) V(q11)
.tran .2p 5n 0 .2p
.end
