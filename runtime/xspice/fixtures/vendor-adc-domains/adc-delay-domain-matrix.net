.model ADC5 adc_bridge(in_low=2.1 in_high=2.2 rise_delay=2p fall_delay=2p time_tol=1p out_low=0 out_high=5 clamp_low=0 clamp_high=5 clamp_res=10 clamp_bias=.5 out_family="HC")
Aadc5 d dig5 ADC5
Adac5 dig5 q5 DAC
R5 q5 0 100k
.model ADC6 adc_bridge(in_low=2.1 in_high=2.2 rise_delay=5p fall_delay=5p time_tol=1p out_low=0 out_high=5 clamp_low=0 clamp_high=5 clamp_res=10 clamp_bias=.5 out_family="HC")
Aadc6 d dig6 ADC6
Adac6 dig6 q6 DAC
R6 q6 0 100k
.model ADC7 adc_bridge(in_low=2.1 in_high=2.2 rise_delay=1n fall_delay=1n time_tol=-1n out_low=0 out_high=5 clamp_low=0 clamp_high=5 clamp_res=10 clamp_bias=.5 out_family="HC")
Aadc7 d dig7 ADC7
Adac7 dig7 q7 DAC
R7 q7 0 100k
.model ADC8 adc_bridge(in_low=2.1 in_high=2.2 rise_delay=1n fall_delay=1n time_tol=0 out_low=0 out_high=5 clamp_low=0 clamp_high=5 clamp_res=10 clamp_bias=.5 out_family="HC")
Aadc8 d dig8 ADC8
Adac8 dig8 q8 DAC
R8 q8 0 100k
.model ADC9 adc_bridge(in_low=2.1 in_high=2.2 rise_delay=1n fall_delay=1n time_tol=.5p out_low=0 out_high=5 clamp_low=0 clamp_high=5 clamp_res=10 clamp_bias=.5 out_family="HC")
Aadc9 d dig9 ADC9
