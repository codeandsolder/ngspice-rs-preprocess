* SIMetrix stateless ALB execution parameter baseline
.model MUSER_CONSTANT d_logic_block file=FUSER_CONSTANT family="UNIV" user=[1]
.file FUSER_CONSTANT
PORT D in[0] ;
PORT Q out[0] ;
Q=USER[0] ? D : 0 ;
.endf
Vdata d 0 PWL(0 0 5n 0 5.1n 5 5.4n 5 5.5n 0 10n 0 10.1n 5 14n 5 14.1n 0 24n 0)
Aalb [d] [q] MUSER_CONSTANT
Rout q 0 100k
.tran 20p 24n 0 20p
.PRINT TRAN V(d) V(q)
.end