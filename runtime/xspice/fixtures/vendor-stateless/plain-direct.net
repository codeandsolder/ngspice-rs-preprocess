* SIMetrix stateless ALB execution parameter baseline
.model MPLAIN_DIRECT d_logic_block file=FPLAIN_DIRECT family="UNIV"
.file FPLAIN_DIRECT
OUT[0]=IN[0] ;
.endf
Vdata d 0 PWL(0 0 5n 0 5.1n 5 5.4n 5 5.5n 0 10n 0 10.1n 5 14n 5 14.1n 0 24n 0)
Aalb [d] [q] MPLAIN_DIRECT
Rout q 0 100k
.tran 20p 24n 0 20p
.PRINT TRAN V(d) V(q)
.end