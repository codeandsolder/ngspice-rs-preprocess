* Signed slew direction, interruptions, UNKNOWN and recovery
.model SRC d_source(input_file="dac-signed-logic-states.txt" input_load=0)
Asrc [dig] SRC
.model DAC0 dac_bridge(in_family="HC" out_low=0 out_high=5 g_pullup=.024 g_pulldown=.034 g_hiz=0 g_resistive=.001 input_load=0 t_rise=1n t_fall=1n knee_low=2 knee_high=2.75 v_smooth=.5)
Adac0 dig q0 DAC0
Vforce0 q0 0 0
Adac1 dig q1 DAC0
Vforce1 q1 0 5
.model DAC1 dac_bridge(in_family="HC" out_low=0 out_high=5 g_pullup=.024 g_pulldown=.034 g_hiz=0 g_resistive=.001 input_load=0 t_rise=-1n t_fall=1n knee_low=2 knee_high=2.75 v_smooth=.5)
Adac2 dig q2 DAC1
Vforce2 q2 0 0
Adac3 dig q3 DAC1
Vforce3 q3 0 5
.model DAC2 dac_bridge(in_family="HC" out_low=0 out_high=5 g_pullup=.024 g_pulldown=.034 g_hiz=0 g_resistive=.001 input_load=0 t_rise=1n t_fall=-1n knee_low=2 knee_high=2.75 v_smooth=.5)
Adac4 dig q4 DAC2
Vforce4 q4 0 0
Adac5 dig q5 DAC2
Vforce5 q5 0 5
.model DAC3 dac_bridge(in_family="HC" out_low=0 out_high=5 g_pullup=.024 g_pulldown=.034 g_hiz=0 g_resistive=.001 input_load=0 t_rise=-1n t_fall=-1n knee_low=2 knee_high=2.75 v_smooth=.5)
Adac6 dig q6 DAC3
Vforce6 q6 0 0
Adac7 dig q7 DAC3
Vforce7 q7 0 5
.model DAC4 dac_bridge(in_family="HC" out_low=0 out_high=5 g_pullup=.024 g_pulldown=.034 g_hiz=0 g_resistive=.001 input_load=0 t_rise=-2n t_fall=1n knee_low=2 knee_high=2.75 v_smooth=.5)
Adac8 dig q8 DAC4
Vforce8 q8 0 0
Adac9 dig q9 DAC4
Vforce9 q9 0 5
.model DAC5 dac_bridge(in_family="HC" out_low=0 out_high=5 g_pullup=.024 g_pulldown=.034 g_hiz=0 g_resistive=.001 input_load=0 t_rise=1n t_fall=-2n knee_low=2 knee_high=2.75 v_smooth=.5)
Adac10 dig q10 DAC5
Vforce10 q10 0 0
Adac11 dig q11 DAC5
Vforce11 q11 0 5
.PRINT TRAN I(Vforce0) I(Vforce1) I(Vforce2) I(Vforce3) I(Vforce4) I(Vforce5) I(Vforce6) I(Vforce7) I(Vforce8) I(Vforce9) I(Vforce10) I(Vforce11)
.tran 2p 15n 0 2p
.end
