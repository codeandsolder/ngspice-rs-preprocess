* Signed explicit DAC transient ramp behavior, forced rail currents
Vd d 0 PWL(0 0 1n 0 1.1n 5 7n 5 7.1n 0 12n 0 12.1n 5 17n 5 17.1n 0 22n 0)
.model ADC adc_schmitt(in_low=2.1 in_high=2.2 rise_delay=1n fall_delay=1n time_tol=1p out_low=0 out_high=5 clamp_low=0 clamp_high=5 clamp_res=10 clamp_bias=.5 out_family="HC")
.model DAC0 dac_bridge(in_family="HC" out_low=0 out_high=5 g_pullup=.024 g_pulldown=.034 g_hiz=1e-9 g_resistive=.001 input_load=0 t_rise=1n t_fall=1n knee_low=2 knee_high=2.75 v_smooth=.5)
Aadc0 d dig0 ADC
Adac0 dig0 q0 DAC0
Vforce0 q0 0 0
Aadc1 d dig1 ADC
Adac1 dig1 q1 DAC0
Vforce1 q1 0 5
.model DAC1 dac_bridge(in_family="HC" out_low=0 out_high=5 g_pullup=.024 g_pulldown=.034 g_hiz=1e-9 g_resistive=.001 input_load=0 t_rise=-1n t_fall=1n knee_low=2 knee_high=2.75 v_smooth=.5)
Aadc2 d dig2 ADC
Adac2 dig2 q2 DAC1
Vforce2 q2 0 0
Aadc3 d dig3 ADC
Adac3 dig3 q3 DAC1
Vforce3 q3 0 5
.model DAC2 dac_bridge(in_family="HC" out_low=0 out_high=5 g_pullup=.024 g_pulldown=.034 g_hiz=1e-9 g_resistive=.001 input_load=0 t_rise=1n t_fall=-1n knee_low=2 knee_high=2.75 v_smooth=.5)
Aadc4 d dig4 ADC
Adac4 dig4 q4 DAC2
Vforce4 q4 0 0
Aadc5 d dig5 ADC
Adac5 dig5 q5 DAC2
Vforce5 q5 0 5
.model DAC3 dac_bridge(in_family="HC" out_low=0 out_high=5 g_pullup=.024 g_pulldown=.034 g_hiz=1e-9 g_resistive=.001 input_load=0 t_rise=-1n t_fall=-1n knee_low=2 knee_high=2.75 v_smooth=.5)
Aadc6 d dig6 ADC
Adac6 dig6 q6 DAC3
Vforce6 q6 0 0
Aadc7 d dig7 ADC
Adac7 dig7 q7 DAC3
Vforce7 q7 0 5
.model DAC4 dac_bridge(in_family="HC" out_low=0 out_high=5 g_pullup=.024 g_pulldown=.034 g_hiz=1e-9 g_resistive=.001 input_load=0 t_rise=-2n t_fall=1n knee_low=2 knee_high=2.75 v_smooth=.5)
Aadc8 d dig8 ADC
Adac8 dig8 q8 DAC4
Vforce8 q8 0 0
Aadc9 d dig9 ADC
Adac9 dig9 q9 DAC4
Vforce9 q9 0 5
.model DAC5 dac_bridge(in_family="HC" out_low=0 out_high=5 g_pullup=.024 g_pulldown=.034 g_hiz=1e-9 g_resistive=.001 input_load=0 t_rise=1n t_fall=-2n knee_low=2 knee_high=2.75 v_smooth=.5)
Aadc10 d dig10 ADC
Adac10 dig10 q10 DAC5
Vforce10 q10 0 0
Aadc11 d dig11 ADC
Adac11 dig11 q11 DAC5
Vforce11 q11 0 5
.PRINT TRAN I(Vforce0) I(Vforce1) I(Vforce2) I(Vforce3) I(Vforce4) I(Vforce5) I(Vforce6) I(Vforce7) I(Vforce8) I(Vforce9) I(Vforce10) I(Vforce11)
.tran 5p 22n 0 5p
.end
