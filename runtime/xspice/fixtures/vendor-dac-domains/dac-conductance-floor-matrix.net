Vforce11 q11 0 1
Adac12 dig q12 DAC2
Vforce12 q12 0 2.35
Adac13 dig q13 DAC2
Vforce13 q13 0 4
Adac14 dig q14 DAC2
Vforce14 q14 0 5
.model DAC3 dac_bridge(in_family="HC" out_low=0 out_high=5 g_pullup=.024 g_pulldown=.034 g_resistive=-.001 g_hiz=.01 input_load=0 t_rise=1n t_fall=1n knee_low=2 knee_high=2.75 v_smooth=.5)
Adac15 dig q15 DAC3
Vforce15 q15 0 0
Adac16 dig q16 DAC3
Vforce16 q16 0 1
Adac17 dig q17 DAC3
Vforce17 q17 0 2.35
Adac18 dig q18 DAC3
Vforce18 q18 0 4
Adac19 dig q19 DAC3
Vforce19 q19 0 5
.model DAC4 dac_bridge(in_family="HC" out_low=0 out_high=5 g_pullup=0 g_pulldown=0 g_resistive=0 g_hiz=.01 input_load=0 t_rise=1n t_fall=1n knee_low=2 knee_high=2.75 v_smooth=.5)
Adac20 dig q20 DAC4
Vforce20 q20 0 0
