* DAC Norton conductance floor and its source intercept
.model SRC d_source(input_file="dac-domain-states.txt" input_load=0)
Asrc [dig] SRC
.model DAC0 dac_bridge(in_family="HC" out_low=0 out_high=5 g_pullup=.024 g_pulldown=.034 g_resistive=.001 g_hiz=.01 input_load=0 t_rise=1n t_fall=1n knee_low=2 knee_high=2.75 v_smooth=.5)
Adac0 dig q0 DAC0
Vforce0 q0 0 0
Adac1 dig q1 DAC0
Vforce1 q1 0 1
Adac2 dig q2 DAC0
Vforce2 q2 0 2.35
Adac3 dig q3 DAC0
Vforce3 q3 0 4
Adac4 dig q4 DAC0
Vforce4 q4 0 5
.model DAC1 dac_bridge(in_family="HC" out_low=0 out_high=5 g_pullup=-.024 g_pulldown=.034 g_resistive=.001 g_hiz=.01 input_load=0 t_rise=1n t_fall=1n knee_low=2 knee_high=2.75 v_smooth=.5)
Adac5 dig q5 DAC1
Vforce5 q5 0 0
Adac6 dig q6 DAC1
Vforce6 q6 0 1
Adac7 dig q7 DAC1
Vforce7 q7 0 2.35
Adac8 dig q8 DAC1
Vforce8 q8 0 4
Adac9 dig q9 DAC1
Vforce9 q9 0 5
