Vforce22 q22 0 2.35
Adac23 dig q23 DAC4
Vforce23 q23 0 4
Adac24 dig q24 DAC4
Vforce24 q24 0 5
.model DAC5 dac_bridge(in_family="HC" out_low=0 out_high=5 g_pullup=.001 g_pulldown=.001 g_resistive=.001 g_hiz=.01 input_load=0 t_rise=1n t_fall=1n knee_low=2 knee_high=2.75 v_smooth=.5)
Adac25 dig q25 DAC5
