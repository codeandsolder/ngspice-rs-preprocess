* Explicit DAC signed conductance and negative smoothing force-current sweep
Vlo lo 0 0
Vhi hi 0 5
.model ADC adc_bridge(in_low=2.1 in_high=2.2 rise_delay=1n fall_delay=1n time_tol=1p out_low=0 out_high=5 clamp_low=0 clamp_high=5 clamp_res=10 clamp_bias=.5 out_family="HC")
.model DAC0 dac_bridge(in_family="HC" out_low=0 out_high=5 g_pullup=.024 g_pulldown=.034 g_resistive=.001 g_hiz=1e-9 input_load=0 t_rise=1n t_fall=1n knee_low=2 knee_high=2.75 v_smooth=.5)
Aadc0 lo dig0 ADC
Adac0 dig0 q0 DAC0
Vforce0 q0 0 PWL(0n -5 0.5n -5 1n -2 1.5n -2 2n -1 2.5n -1 3n 0 3.5n 0 4n .25 4.5n .25 5n .5 5.5n .5 6n 1 6.5n 1 7n 1.49 7.5n 1.49 8n 1.5 8.5n 1.5 9n 1.51 9.5n 1.51 10n 1.75 10.5n 1.75 11n 2 11.5n 2 12n 2.25 12.5n 2.25 13n 2.5 13.5n 2.5 14n 2.75 14.5n 2.75 15n 3 15.5n 3 16n 3.25 16.5n 3.25 17n 3.5 17.5n 3.5 18n 4 18.5n 4 19n 4.5 19.5n 4.5 20n 5 20.5n 5 21n 6 21.5n 6 22n 7 22.5n 7 23n 10 24n 10)
Aadc1 hi dig1 ADC
