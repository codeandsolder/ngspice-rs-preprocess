* DAC Norton zero-current intercept vs arbitrarily small nonzero rail offsets
Vlo lo 0 0
.model ADC adc_bridge(in_low=2.1 in_high=2.2 rise_delay=1n fall_delay=1n time_tol=1p out_low=0 out_high=5 clamp_low=0 clamp_high=5 clamp_res=10 clamp_bias=.5 out_family="HC")
.model DAC0 dac_bridge(in_family="HC" out_low=0 out_high=5 g_pullup=.024 g_pulldown=.034 g_resistive=.001 g_hiz=.01 input_load=0 t_rise=1n t_fall=1n knee_low=2 knee_high=2.75 v_smooth=.5)
Aadc0 lo dig0 ADC
Adac0 dig0 q0 DAC0
Vforce0 q0 0 PWL(0 0 1n 0 1.5n 0.5 2n 0.5 2.5n 1.5 3n 1.5 3.5n 1.500001 4n 1.500001 4.5n 1.501 5n 1.501 5.5n 2 6n 2 6.5n 0 7n 0)
.model DAC1 dac_bridge(in_family="HC" out_low=1e-12 out_high=5.000000000001 g_pullup=.024 g_pulldown=.034 g_resistive=.001 g_hiz=.01 input_load=0 t_rise=1n t_fall=1n knee_low=2.000000000001 knee_high=2.750000000001 v_smooth=.5)
Aadc1 lo dig1 ADC
Adac1 dig1 q1 DAC1
Vforce1 q1 0 PWL(0 1E-12 1n 1E-12 1.5n 0.500000000001 2n 0.500000000001 2.5n 1.500000000001 3n 1.500000000001 3.5n 1.500001000001 4n 1.500001000001 4.5n 1.501000000001 5n 1.501000000001 5.5n 2.000000000001 6n 2.000000000001 6.5n 1E-12 7n 1E-12)
.model DAC2 dac_bridge(in_family="HC" out_low=-1e-12 out_high=4.999999999999 g_pullup=.024 g_pulldown=.034 g_resistive=.001 g_hiz=.01 input_load=0 t_rise=1n t_fall=1n knee_low=1.999999999999 knee_high=2.749999999999 v_smooth=.5)
Aadc2 lo dig2 ADC
Adac2 dig2 q2 DAC2
Vforce2 q2 0 PWL(0 -1E-12 1n -1E-12 1.5n 0.499999999999 2n 0.499999999999 2.5n 1.499999999999 3n 1.499999999999 3.5n 1.500000999999 4n 1.500000999999 4.5n 1.500999999999 5n 1.500999999999 5.5n 1.999999999999 6n 1.999999999999 6.5n -1E-12 7n -1E-12)
.model DAC3 dac_bridge(in_family="HC" out_low=1e-9 out_high=5.000000001 g_pullup=.024 g_pulldown=.034 g_resistive=.001 g_hiz=.01 input_load=0 t_rise=1n t_fall=1n knee_low=2.000000001 knee_high=2.750000001 v_smooth=.5)
Aadc3 lo dig3 ADC
Adac3 dig3 q3 DAC3
Vforce3 q3 0 PWL(0 1E-09 1n 1E-09 1.5n 0.500000001 2n 0.500000001 2.5n 1.500000001 3n 1.500000001 3.5n 1.500001001 4n 1.500001001 4.5n 1.501000001 5n 1.501000001 5.5n 2.000000001 6n 2.000000001 6.5n 1E-09 7n 1E-09)
.model DAC4 dac_bridge(in_family="HC" out_low=-1e-9 out_high=4.999999999 g_pullup=.024 g_pulldown=.034 g_resistive=.001 g_hiz=.01 input_load=0 t_rise=1n t_fall=1n knee_low=1.999999999 knee_high=2.749999999 v_smooth=.5)
Aadc4 lo dig4 ADC
Adac4 dig4 q4 DAC4
Vforce4 q4 0 PWL(0 -1E-09 1n -1E-09 1.5n 0.499999999 2n 0.499999999 2.5n 1.499999999 3n 1.499999999 3.5n 1.500000999 4n 1.500000999 4.5n 1.500999999 5n 1.500999999 5.5n 1.999999999 6n 1.999999999 6.5n -1E-09 7n -1E-09)
.model DAC5 dac_bridge(in_family="HC" out_low=1e-6 out_high=5.000001 g_pullup=.024 g_pulldown=.034 g_resistive=.001 g_hiz=.01 input_load=0 t_rise=1n t_fall=1n knee_low=2.000001 knee_high=2.750001 v_smooth=.5)
Aadc5 lo dig5 ADC
Adac5 dig5 q5 DAC5
Vforce5 q5 0 PWL(0 1E-06 1n 1E-06 1.5n 0.500001 2n 0.500001 2.5n 1.500001 3n 1.500001 3.5n 1.500002 4n 1.500002 4.5n 1.501001 5n 1.501001 5.5n 2.000001 6n 2.000001 6.5n 1E-06 7n 1E-06)
.model DAC6 dac_bridge(in_family="HC" out_low=-1e-6 out_high=4.999999 g_pullup=.024 g_pulldown=.034 g_resistive=.001 g_hiz=.01 input_load=0 t_rise=1n t_fall=1n knee_low=1.999999 knee_high=2.749999 v_smooth=.5)
Aadc6 lo dig6 ADC
Adac6 dig6 q6 DAC6
Vforce6 q6 0 PWL(0 -1E-06 1n -1E-06 1.5n 0.499999 2n 0.499999 2.5n 1.499999 3n 1.499999 3.5n 1.5 4n 1.5 4.5n 1.500999 5n 1.500999 5.5n 1.999999 6n 1.999999 6.5n -1E-06 7n -1E-06)
.model DAC7 dac_bridge(in_family="HC" out_low=.001 out_high=5.001 g_pullup=.024 g_pulldown=.034 g_resistive=.001 g_hiz=.01 input_load=0 t_rise=1n t_fall=1n knee_low=2.001 knee_high=2.751 v_smooth=.5)
Aadc7 lo dig7 ADC
Adac7 dig7 q7 DAC7
Vforce7 q7 0 PWL(0 0.001 1n 0.001 1.5n 0.501 2n 0.501 2.5n 1.501 3n 1.501 3.5n 1.501001 4n 1.501001 4.5n 1.502 5n 1.502 5.5n 2.001 6n 2.001 6.5n 0.001 7n 0.001)
.model DAC8 dac_bridge(in_family="HC" out_low=-.001 out_high=4.999 g_pullup=.024 g_pulldown=.034 g_resistive=.001 g_hiz=.01 input_load=0 t_rise=1n t_fall=1n knee_low=1.999 knee_high=2.749 v_smooth=.5)
Aadc8 lo dig8 ADC
Adac8 dig8 q8 DAC8
Vforce8 q8 0 PWL(0 -0.001 1n -0.001 1.5n 0.499 2n 0.499 2.5n 1.499 3n 1.499 3.5n 1.499001 4n 1.499001 4.5n 1.5 5n 1.5 5.5n 1.999 6n 1.999 6.5n -0.001 7n -0.001)
.model DAC9 dac_bridge(in_family="HC" out_low=1 out_high=6 g_pullup=.024 g_pulldown=.034 g_resistive=.001 g_hiz=.01 input_load=0 t_rise=1n t_fall=1n knee_low=3 knee_high=3.75 v_smooth=.5)
Aadc9 lo dig9 ADC
Adac9 dig9 q9 DAC9
Vforce9 q9 0 PWL(0 1 1n 1 1.5n 1.5 2n 1.5 2.5n 2.5 3n 2.5 3.5n 2.500001 4n 2.500001 4.5n 2.501 5n 2.501 5.5n 3 6n 3 6.5n 1 7n 1)
.model DAC10 dac_bridge(in_family="HC" out_low=-1 out_high=4 g_pullup=.024 g_pulldown=.034 g_resistive=.001 g_hiz=.01 input_load=0 t_rise=1n t_fall=1n knee_low=1 knee_high=1.75 v_smooth=.5)
Aadc10 lo dig10 ADC
Adac10 dig10 q10 DAC10
Vforce10 q10 0 PWL(0 -1 1n -1 1.5n -0.5 2n -0.5 2.5n 0.5 3n 0.5 3.5n 0.500001 4n 0.500001 4.5n 0.501 5n 0.501 5.5n 1 6n 1 6.5n -1 7n -1)
.model DAC11 dac_bridge(in_family="HC" out_low=-2.5 out_high=2.5 g_pullup=.024 g_pulldown=.034 g_resistive=.001 g_hiz=.01 input_load=0 t_rise=1n t_fall=1n knee_low=-0.5 knee_high=0.25 v_smooth=.5)
Aadc11 lo dig11 ADC
Adac11 dig11 q11 DAC11
Vforce11 q11 0 PWL(0 -2.5 1n -2.5 1.5n -2 2n -2 2.5n -1 3n -1 3.5n -0.999999 4n -0.999999 4.5n -0.999 5n -0.999 5.5n -0.5 6n -0.5 6.5n -2.5 7n -2.5)
.PRINT TRAN I(Vforce0) I(Vforce1) I(Vforce2) I(Vforce3) I(Vforce4) I(Vforce5) I(Vforce6) I(Vforce7) I(Vforce8) I(Vforce9) I(Vforce10) I(Vforce11)
.tran 5p 7n 0 5p
.end
