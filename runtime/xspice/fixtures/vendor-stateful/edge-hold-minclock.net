* Vendor-only: deliberate too-short clock and post-edge HOLD violation.
* HOLD and MINCLOCK must not be inferred from simple rising-edge behavior.
.model MEDGE d_logic_block file=EDGE_TIMING family="UNIV"
.file EDGE_TIMING
PORT Data in[0] ;
PORT Clock in[1] ;
PORT (DELAY=200p) Q out[0] ;
EDGE (WIDTH=1, DELAY=1n, MINCLOCK=600p, HOLD=900p, CLOCK=in[1]) Flip=0 ;
Flip = Data ;
Q = Flip ;
.endf
Vdata d 0 PWL(0 0 2n 0 2.1n 5 14n 5 14.3n 0 20n 0 20.1n 5 32n 5 32.1n 0 44n 0)
Vclock ck 0 PWL(0 0 5n 0 5.02n 5 5.4n 5 5.42n 0 14n 0 14.02n 5 17n 5 17.02n 0 24n 0 24.02n 5 27n 5 27.02n 0 34n 0 34.02n 5 37n 5 37.02n 0 44n 0)
Aseq [d ck] [q] MEDGE
Rout q 0 100k
.tran 20p 44n 0 20p
.PRINT TRAN V(d) V(ck) V(q)
.end
