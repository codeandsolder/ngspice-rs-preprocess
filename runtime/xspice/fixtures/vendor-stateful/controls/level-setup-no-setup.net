* Vendor-only: close latch with data changing inside and outside SETUP window.
.model MLEVEL d_logic_block file=LEVEL_SETUP family="UNIV"
.file LEVEL_SETUP
PORT Data in[0] ;
PORT Enable in[1] ;
PORT (DELAY=200p) Q out[0] ;
LEVEL (WIDTH=1, DELAY=2n, SETUP=0, CLOCK=in[1]) Latch=0 ;
Latch = Data ;
Q = Latch ;
.endf
Vdata d 0 PWL(0 0 5n 0 5.1n 5 19.4n 5 19.5n 0 26n 0 26.1n 5 35n 5 35.1n 0 44n 0)
Venable en 0 PWL(0 0 9.9n 0 10n 5 19.9n 5 20n 0 29.9n 0 30n 5 39.9n 5 40n 0 44n 0)
Alatch [d en] [q] MLEVEL
Rout q 0 100k
.tran 20p 44n 0 20p
.PRINT TRAN V(d) V(en) V(q)
.end
