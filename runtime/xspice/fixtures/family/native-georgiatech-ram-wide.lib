* Genuine original Georgia Tech XSPICE d_ram with physical state/sink/source triples.
.subckt SR_GT_RAM_WIDE D0 D0_SINK D0_SOURCE D1 D1_SINK D1_SOURCE D2 D2_SINK D2_SOURCE D3 D3_SINK D3_SOURCE A0 A0_SINK A0_SOURCE A1 A1_SINK A1_SOURCE A2 A2_SINK A2_SOURCE WE WE_SINK WE_SOURCE S0 S0_SINK S0_SOURCE S1 S1_SINK S1_SOURCE S2 S2_SINK S2_SOURCE OUT0 OUT1 OUT2 OUT3
Aload_d0 D0 D0_SINK D0_SOURCE RAM_LOAD
Aload_d1 D1 D1_SINK D1_SOURCE RAM_LOAD
Aload_d2 D2 D2_SINK D2_SOURCE RAM_LOAD
Aload_d3 D3 D3_SINK D3_SOURCE RAM_LOAD
Aload_a0 A0 A0_SINK A0_SOURCE RAM_LOAD
Aload_a1 A1 A1_SINK A1_SOURCE RAM_LOAD
Aload_a2 A2 A2_SINK A2_SOURCE RAM_LOAD
Aload_we WE WE_SINK WE_SOURCE RAM_LOAD
Aload_s0 S0 S0_SINK S0_SOURCE RAM_LOAD
Aload_s1 S1 S1_SINK S1_SOURCE RAM_LOAD
Aload_s2 S2 S2_SINK S2_SOURCE RAM_LOAD
.model RAM_LOAD sr_bundle_load(capacitance=2p sink_current=0 source_current=0)
Aram [D0 D1 D2 D3] [Q0 Q1 Q2 Q3] [A0 A1 A2] WE [S0 S1 S2] GT_ORIGINAL_RAM
.model GT_ORIGINAL_RAM d_ram(select_value=5 ic=2 read_delay=600p data_load=0 address_load=0 select_load=0 enable_load=0)
Aout0 Q0 Q0_SINK Q0_SOURCE %gd(OUT0 0) RAM_FAMILY
Aout1 Q1 Q1_SINK Q1_SOURCE %gd(OUT1 0) RAM_FAMILY
Aout2 Q2 Q2_SINK Q2_SOURCE %gd(OUT2 0) RAM_FAMILY
Aout3 Q3 Q3_SINK Q3_SOURCE %gd(OUT3 0) RAM_FAMILY
.model RAM_FAMILY sr_family_dac(out_low=0 out_high=3.3 g_pullup=.024 g_pulldown=.034 g_resistive=.001 g_hiz=1e-8 knee_low=2 knee_high=2.75 v_smooth=.5 input_load=0 t_rise=50p t_fall=50p)
.ends SR_GT_RAM_WIDE
