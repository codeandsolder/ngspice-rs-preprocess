* Original Georgia Tech 1991 mixed analog/digital: differential ADC + AND + DAC.
.subckt SR_ORIGINAL_MIXED APLUS VCM D0 D0_SINK D0_SOURCE ANALOG_PROBE ANALOG_OUT
AloadD0 D0 D0_SINK D0_SOURCE INPUT_LOAD
.model INPUT_LOAD sr_bundle_load(capacitance=2p sink_current=0 source_current=0)
Aadc [%vd(APLUS VCM)] [A_BIT] GT_ADC
.model GT_ADC adc_bridge(in_low=1.386 in_high=1.452 rise_delay=1p fall_delay=1p)
Aand [A_BIT D0] OUT_BIT GT_AND
.model GT_AND d_and(rise_delay=450p fall_delay=500p input_load=0 inertial_delay=false)
Adac [A_BIT OUT_BIT] [ANALOG_PROBE ANALOG_OUT] GT_DAC
.model GT_DAC dac_bridge(out_low=0 out_high=3.3 out_undef=1.65 input_load=0 t_rise=50p t_fall=50p)
.ends SR_ORIGINAL_MIXED
