* Exact unchanged original ngspice47 digital source, d_to_real, real_delay, real_gain and real_to_v C instances.
.subckt SR_ORIGINAL_CLOCKED_REAL EN EN_SINK EN_SOURCE ANALOG_RAW ANALOG_HELD ANALOG_POST ANALOG_ENABLED ANALOG_PROBE
AloadEn EN EN_SINK EN_SOURCE INPUT_LOAD
.model INPUT_LOAD sr_bundle_load(capacitance=2p sink_current=0 source_current=0)
AsourceData [DATA] ORIGINAL_DATA
AsourceClock [CLK] ORIGINAL_CLOCK
Ad2r DATA NULL RDATA ORIGINAL_D2R
Ahold RDATA CLK RHELD ORIGINAL_DELAY
Again RHELD RPOST ORIGINAL_GAIN
Aenabled DATA EN RENABLE ORIGINAL_DENABLE
Araw RDATA ANALOG_RAW ORIGINAL_R2V
Aheld RHELD ANALOG_HELD ORIGINAL_R2V
Apost RPOST ANALOG_POST ORIGINAL_R2V
AenProbe RENABLE ANALOG_ENABLED ORIGINAL_R2V
Aprobe DATA Q_SINK Q_SOURCE %gd(ANALOG_PROBE 0) ORIGINAL_PROBE
.model ORIGINAL_DATA d_source(input_file="original-clocked-real-data.txt" input_load=0)
.model ORIGINAL_CLOCK d_source(input_file="original-clocked-real-clock.txt" input_load=0)
.model ORIGINAL_D2R d_to_real(zero=-0.5 one=2 delay=220p)
.model ORIGINAL_DELAY real_delay(delay=610p)
.model ORIGINAL_GAIN real_gain(in_offset=0.25 gain=-0.7 out_offset=0.125 delay=180p ic=0.1)
.model ORIGINAL_DENABLE d_to_real(zero=-0.25 one=1.75 delay=350p)
.model ORIGINAL_R2V real_to_v(gain=1 transition_time=400p)
.model ORIGINAL_PROBE sr_family_dac(out_low=0 out_high=3.3 g_pullup=.024 g_pulldown=.034 g_resistive=.001 g_hiz=1e-8 knee_low=2 knee_high=2.75 v_smooth=.5 input_load=0 t_rise=50p t_fall=50p)
.ends SR_ORIGINAL_CLOCKED_REAL
