* Genuine non-Rust event-state tri-state native replacement.
* Aload explicitly consumes the externally contracted sink/source metadata,
* so the original ALB upstream drivers experience physical digital pin load.
.subckt SR_NATIVE_TRI_DRIVER D D_SINK D_SOURCE OE OE_SINK OE_SOURCE OUT
Adata_load D D_SINK D_SOURCE LOADER
Aenable_load OE OE_SINK OE_SOURCE LOADER
.model LOADER sr_bundle_load(capacitance=2p sink_current=0 source_current=0)
Atri D OE Q TRI
.model TRI d_tristate(delay=1p input_load=0 enable_load=0)
Afam Q Q_SINK Q_SOURCE %gd(OUT 0) FAM
.model FAM sr_family_dac(out_low=0 out_high=3.3 g_pullup=.024 g_pulldown=.034 g_resistive=.001 g_hiz=1e-8 knee_low=2 knee_high=2.75 v_smooth=.5 input_load=0 t_rise=2n t_fall=2n)
.ends SR_NATIVE_TRI_DRIVER
