* Original XSPICE real UDN resolves all simultaneous original C-model drivers by addition.
.subckt SR_ORIGINAL_REAL_SUM EN EN_SINK EN_SOURCE ANALOG_SUM ANALOG_POST ANALOG_ENABLED ANALOG_PROBE
AloadEn EN EN_SINK EN_SOURCE INPUT_LOAD
.model INPUT_LOAD sr_bundle_load(capacitance=2p sink_current=0 source_current=0)
Asource0 [Q0] ORIGINAL_SOURCE0
Asource1 [Q1] ORIGINAL_SOURCE1
Asource2 [Q2] ORIGINAL_SOURCE2
ArealB Q1 NULL BPRE ORIGINAL_DB
ArealA Q0 NULL REAL_SUM ORIGINAL_DA
AgainB BPRE REAL_SUM ORIGINAL_GAIN_B
ArealC Q2 NULL REAL_SUM ORIGINAL_DC
Ad2enable Q0 EN R_ENABLED ORIGINAL_DENABLE
AgainPost REAL_SUM RPOST ORIGINAL_GAIN_POST
Areadout REAL_SUM ANALOG_SUM ORIGINAL_R2V
Apost RPOST ANALOG_POST ORIGINAL_R2V
Aenabled R_ENABLED ANALOG_ENABLED ORIGINAL_R2V
Aprobe Q0 Q_SINK Q_SOURCE %gd(ANALOG_PROBE 0) ORIGINAL_PROBE
.model ORIGINAL_DA d_to_real(zero=1e16 one=1e16 delay=200p)
.model ORIGINAL_DB d_to_real(zero=1.25 one=-0.75 delay=300p)
.model ORIGINAL_DC d_to_real(zero=-1e16 one=-1e16 delay=700p)
.model ORIGINAL_DENABLE d_to_real(zero=0.25 one=2.25 delay=350p)
.model ORIGINAL_GAIN_B real_gain(in_offset=0.125 gain=0 out_offset=1 delay=240p ic=1)
.model ORIGINAL_GAIN_POST real_gain(in_offset=0.375 gain=-0.5 out_offset=0.125 delay=180p ic=-1.125)
.model ORIGINAL_R2V real_to_v(gain=1 transition_time=400p)
.model ORIGINAL_PROBE sr_family_dac(out_low=0 out_high=3.3 g_pullup=.024 g_pulldown=.034 g_resistive=.001 g_hiz=1e-8 knee_low=2 knee_high=2.75 v_smooth=.5 input_load=0 t_rise=50p t_fall=50p)
.model ORIGINAL_SOURCE0 d_source(input_file="original-real-sum-driver-0.txt" input_load=0)
.model ORIGINAL_SOURCE1 d_source(input_file="original-real-sum-driver-1.txt" input_load=0)
.model ORIGINAL_SOURCE2 d_source(input_file="original-real-sum-driver-2.txt" input_load=0)
.ends SR_ORIGINAL_REAL_SUM
