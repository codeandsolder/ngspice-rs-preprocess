* Real Elements 9.40d internal COMB reset release versus EDGE clock ordering
.model MRELEASE_CLOCK_MINUS_2PS d_logic_block file=FRELEASE_CLOCK_MINUS_2PS family="UNIV"
.file FRELEASE_CLOCK_MINUS_2PS
PORT Data in[0] ;
PORT Clock in[1] ;
PORT Reset in[2] ;
PORT Q out[0] ;
COMB (WIDTH=1, DELAY=1n) ResetPipe=0 ;
EDGE (WIDTH=1, DELAY=1n, ASYNCDELAY=200p, CLOCK=in[1]) Flip=0 ;
ResetPipe = Reset ;
Flip := !ResetPipe ? 0 ;
Flip = Data ;
Q = Flip ;
.endf
Vdata d 0 PWL(0 0 5n 0 5.1n 5 36n 5)
Vclock ck 0 PWL(0 0 10.898n 0 10.998n 5 11.9n 5 12n 0 29.9n 0 30n 5 31n 5 31.1n 0 36n 0)
Vreset rst 0 PWL(0 0 9.9n 0 10n 5 36n 5)
Aseq [d ck rst] [q] MRELEASE_CLOCK_MINUS_2PS
Rout q 0 100k
.tran 1p 36n 0 1p
.PRINT TRAN V(d) V(ck) V(rst) V(q)
.end
