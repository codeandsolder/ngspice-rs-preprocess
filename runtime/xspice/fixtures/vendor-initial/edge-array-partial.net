* Original-source SIMetrix 9.40d array partial initializer probe
.model MARRAY d_logic_block file=ARRAY_PARTIAL family="UNIV"
.file ARRAY_PARTIAL
PORT Data in[0] ;
PORT Clock in[1] ;
PORT Q0 out[0] ;
PORT Q1 out[1] ;
EDGE (WIDTH=1, DELAY=1n, CLOCK=in[1]) R[2]=1 ;
R[0]=Data ;
R[1]=!Data ;
Q0=R[0] ;
Q1=R[1] ;
.endf
Vdata d 0 PWL(0 0 42n 0)
Vclock ck 0 PWL(0 0 9.9n 0 10n 5 12n 5 12.1n 0 42n 0)
Aarray [d ck] [q0 q1] MARRAY
Rout0 q0 0 100k
Rout1 q1 0 100k
.tran 20p 42n 0 20p
.PRINT TRAN V(d) V(ck) V(q0) V(q1)
.end