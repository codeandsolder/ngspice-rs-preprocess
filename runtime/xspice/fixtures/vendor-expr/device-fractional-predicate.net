* Experimental vendor oracle: fractional USER/DEVICE inside ALB general expressions
.model MDEVICE_FRACTIONAL_PREDICATE d_logic_block file=FDEVICE_FRACTIONAL_PREDICATE family="UNIV"
.file FDEVICE_FRACTIONAL_PREDICATE
PORT Data in[0] ;
PORT Q out[0] ;
COMB (WIDTH=1, DELAY=1n) Stage=0 ;
Stage=(DEVICE[0]>0) ? Data : 0 ;
Q=Stage ;
.endf
Vdata d 0 PWL(0 0 5n 0 5.1n 5 5.4n 5 5.5n 0 10n 0 10.1n 5 14n 5 14.1n 0 24n 0)
Aalb [d] [q] MDEVICE_FRACTIONAL_PREDICATE : USER=[0.5]
Rout q 0 100k
.tran 20p 24n 0 20p
.PRINT TRAN V(d) V(q)
.end
