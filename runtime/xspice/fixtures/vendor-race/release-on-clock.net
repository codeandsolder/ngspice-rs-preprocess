* Proprietary SIMetrix 9.40d asynchronous reset/clock interaction oracle
.model MRELEASE_ON_CLOCK d_logic_block file=FRELEASE_ON_CLOCK family="UNIV"
.file FRELEASE_ON_CLOCK
PORT Data in[0] ;
PORT Clock in[1] ;
PORT Reset in[2] ;
PORT Q out[0] ;
EDGE (WIDTH=1, DELAY=1n, ASYNCDELAY=200p, CLOCK=in[1]) Flip=0 ;
Flip := !Reset ? 0 ;
Flip = Data ;
Q = Flip ;
.endf
Vdata d 0 PWL(0 0 5n 0 5.1n 5 52n 5)
Vclock ck 0 PWL(0 0 9.9n 0 10n 5 12n 5 12.1n 0 19.9n 0 20n 5 22n 5 22.1n 0 29.9n 0 30n 5 32n 5 32.1n 0 39.9n 0 40n 5 42n 5 42.1n 0 52n 0)
Vreset rst 0 PWL(0 0 9.9n 0 10n 5 52n 5)
Aseq [d ck rst] [q] MRELEASE_ON_CLOCK
Rout q 0 100k
.tran 20p 52n 0 20p
.PRINT TRAN V(d) V(ck) V(rst) V(q)
.end