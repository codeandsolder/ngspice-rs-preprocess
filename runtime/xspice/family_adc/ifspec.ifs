NAME_TABLE:
Spice_Model_Name:      sr_family_adc
C_Function_Name:       cm_sr_family_adc
Description:           "experimental family ADC with physical clamp and reflected load"

PORT_TABLE:
Port_Name:             analog              out                 sink_meta           source_meta
Description:           "analog terminal"   "digital state"     "sink metadata"      "source metadata"
Direction:             inout               out                 out                 out
Default_Type:          gd                  d                   d                   d
Allowed_Types:         [gd]                [d]                 [d]                 [d]
Vector:                no                  no                  no                  no
Vector_Bounds:         -                   -                   -                   -
Null_Allowed:          no                  no                  no                  no

PARAMETER_TABLE:
Parameter_Name:        in_low           in_high         rise_delay       fall_delay
Description:           "low threshold"   "high threshold" "rise seconds"    "fall seconds"
Data_Type:             real             real            real             real
Default_Value:         0.1              0.9             1e-9             1e-9
Limits:                -                -               -                -
Vector:                no               no              no               no
Vector_Bounds:         -                -               -                -
Null_Allowed:          yes              yes             yes              yes

PARAMETER_TABLE:
Parameter_Name:        out_low          out_high        clamp_low         clamp_high
Description:           "load low V"      "load high V"    "low clamp V"      "high clamp V"
Data_Type:             real             real            real              real
Default_Value:         0                5               0                 5
Limits:                -                -               -                 -
Vector:                no               no              no                no
Vector_Bounds:         -                -               -                 -
Null_Allowed:          yes              yes             yes               yes

PARAMETER_TABLE:
Parameter_Name:        clamp_res        clamp_bias      schmitt
Description:           "clamp ohms"      "diode knee V"  "hold band state"
Data_Type:             real             real            boolean
Default_Value:         1                0.8             false
Limits:                -                -               -
Vector:                no               no              no
Vector_Bounds:         -                -               -
Null_Allowed:          yes              yes             yes


PARAMETER_TABLE:
Parameter_Name:        time_tol
Description:           "max threshold crossing time error in seconds"
Data_Type:             real
Default_Value:         100e-12
Limits:                -
Vector:                no
Vector_Bounds:         -
Null_Allowed:          yes
