NAME_TABLE:
Spice_Model_Name:      sr_family_dac
C_Function_Name:       cm_sr_family_dac
Description:           "experimental nonlinear SIMetrix-style digital-to-analog bridge"

PORT_TABLE:
Port_Name:             in                  sink_meta          source_meta          out
Description:           "digital state"     "sink-current load" "source-current load" "analog stage"
Direction:             in                  in                 in                   inout
Default_Type:          d                   d                  d                    gd
Allowed_Types:         [d]                 [d]                [d]                  [gd]
Vector:                no                  no                 no                   no
Vector_Bounds:         -                   -                  -                    -
Null_Allowed:          no                  no                 no                   no

PARAMETER_TABLE:
Parameter_Name:        out_low             out_high          g_pullup        g_pulldown
Description:           "analog zero V"     "analog one V"    "one S"         "zero S"
Data_Type:             real                real              real            real
Default_Value:         0                   5                 0.01            0.01
Limits:                -                   -                 -               -
Vector:                no                  no                no              no
Vector_Bounds:         -                   -                 -               -
Null_Allowed:          yes                 yes               yes             yes

PARAMETER_TABLE:
Parameter_Name:        g_resistive         g_hiz             knee_low        knee_high
Description:           "resistive S"       "hi-Z S"         "zero knee V"    "one knee V"
Data_Type:             real                real              real            real
Default_Value:         0.001               1e-9              2               3
Limits:                -                   -                 -               -
Vector:                no                  no                no              no
Vector_Bounds:         -                   -                 -               -
Null_Allowed:          yes                 yes               yes             yes

PARAMETER_TABLE:
Parameter_Name:        v_smooth            input_load        t_rise          t_fall
Description:           "knee offset V"     "digital load F"  "rise sec"      "fall sec"
Data_Type:             real                real              real            real
Default_Value:         0                   1e-12             1e-9            1e-9
Limits:                -                   -                 -               -
Vector:                no                  no                no              no
Vector_Bounds:         -                   -                 -               -
Null_Allowed:          yes                 yes               yes             yes

PARAMETER_TABLE:
Parameter_Name:        sink_current        source_current
Description:           "low input load A"  "high input load A"
Data_Type:             real                real
Default_Value:         0                   0
Limits:                -                   -
Vector:                no                  no
Vector_Bounds:         -                   -
Null_Allowed:          yes                 yes
