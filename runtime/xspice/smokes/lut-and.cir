* two-input timed ALB AND LUT
Va ain 0 PULSE(0 1 1n 1p 1p 8n 30n)
Vb bin 0 1
Aadc [ain bin] [da db] ADC
.model ADC adc_bridge(in_low=.25 in_high=.75 rise_delay=1p fall_delay=1p)
Alut [da db] dout dout_sink dout_source 0 LUT
.model LUT sr_alb_lut_bit(table_values="0001" delay=2n input_load=4p out_res=0 ic=0 inertial_delay=true)
Adac [dout] [aout] DAC
.model DAC dac_bridge(out_low=0 out_high=1 input_load=0 t_rise=1p t_fall=1p)
Rout aout 0 1k
.tran 1p 16n
.control
run
wrdata lut-and.dat v(aout)
quit
.endc
.end
