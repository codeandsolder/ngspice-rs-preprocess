NAME_TABLE:
Spice_Model_Name:      sr_alb_lut_bit
C_Function_Name:       cm_sr_alb_lut_bit
Description:           "ngspice-rs-preprocess experimental timed per-bit ALB LUT"

PORT_TABLE:
Port_Name:             in                   out                  sink_meta           source_meta          wake
Description:           "digital sources"    "one output bit"     "sink current sum"   "source current sum"   "startup wake"
Direction:             in                   out                  out                 out                  in
Default_Type:          d                    d                    d                   d                    v
Allowed_Types:         [d]                  [d]                  [d]                 [d]                  [v]
Vector:                yes                  no                   no                  no                   no
Vector_Bounds:         -                    -                    -                   -                    -
Null_Allowed:          no                   no                   no                  no                   no

PARAMETER_TABLE:
Parameter_Name:        table_values          delay                 out_res_pos           out_res_neg
Description:           "binary row LUT"      "stage base delay"    "positive resistance" "negative resistance"
Data_Type:             string                real                  real                  real
Default_Value:         -                     1e-9                  0                     0
Limits:                -                     -                     -                     -
Vector:                no                    no                    no                    no
Vector_Bounds:         -                     -                     -                     -
Null_Allowed:          no                    yes                   yes                   yes

PARAMETER_TABLE:
Parameter_Name:        min_sink            max_source
Description:           "sink current floor" "source current ceiling"
Data_Type:             real                real
Default_Value:         -1e99               1e99
Limits:                -                   -
Vector:                no                  no
Vector_Bounds:         -                   -
Null_Allowed:          yes                 yes

PARAMETER_TABLE:
Parameter_Name:        input_load            ic                    inertial_delay
Description:           "input capacitance"   "initial state"       "swallow pulses"
Data_Type:             real                  int                   boolean
Default_Value:         0                     0                     true
Limits:                [0 -]                 [0 2]                 -
Vector:                no                    no                    no
Vector_Bounds:         -                     -                     -
Null_Allowed:          yes                   yes                   yes

STATIC_VAR_TABLE:
Static_Var_Name:       is_inertial           transient_wake_queued   valid
Data_Type:             boolean               boolean                 boolean
Description:           "inertial timing"     "startup event queued"  "valid LUT"

PARAMETER_TABLE:
Parameter_Name:        unknown_as_zero      unknown_as_last
Description:           "initial UNKNOWN->LOW"   "retain last known input when UNKNOWN"
Data_Type:             boolean              boolean
Default_Value:         false                false
Limits:                -                    -
Vector:                no                   no
Vector_Bounds:         -                    -
Null_Allowed:          yes                  yes


PARAMETER_TABLE:
Parameter_Name:        retain_disabled_polarity
Description:           "retain requested logic while disabled"
Data_Type:             boolean
Default_Value:         false
Limits:                -
Vector:                no
Vector_Bounds:         -
Null_Allowed:          yes

PARAMETER_TABLE:
Parameter_Name:        minimum_delay
Description:           "minimum effective propagation delay"
Data_Type:             real
Default_Value:         0
Limits:                [0 -]
Vector:                no
Vector_Bounds:         -
Null_Allowed:          yes
