* JFET gate saturation current defaults
.temp 27
Vd d 0 2
Vg g 0 -2
Vp dp 0 -2
Vgp gp 0 2
.model mNdefault NJF (IS=15p BETA=270.1u VTO=-1)
JNdefault d g 0 mNdefault
.model mN0 NJF (IS=15p BETA=270.1u VTO=-1 XTI=0)
JN0 d g 0 mN0
.model mN2 NJF (IS=15p BETA=270.1u VTO=-1 XTI=2)
JN2 d g 0 mN2
.model mN3 NJF (IS=15p BETA=270.1u VTO=-1 XTI=3)
JN3 d g 0 mN3
.model mPdefault PJF (IS=15p BETA=270.1u VTO=-1)
JPdefault dp gp 0 mPdefault
.model mP0 PJF (IS=15p BETA=270.1u VTO=-1 XTI=0)
JP0 dp gp 0 mP0
.model mP2 PJF (IS=15p BETA=270.1u VTO=-1 XTI=2)
JP2 dp gp 0 mP2
.model mP3 PJF (IS=15p BETA=270.1u VTO=-1 XTI=3)
JP3 dp gp 0 mP3
.op
.end
