* BJT model absolute temperature with parameterized instances
.temp 85
Vb b 0 .65
V1 c1 0 2
V2 c2 0 2
V3 c3 0 2
X1 c1 b 0 BJT params: temp_choice=0
X2 c2 b 0 BJT params: temp_choice=1
X3 c3 b 0 BJT params: temp_choice=2
.subckt BJT c b e
Q1 c b e N1
.model N1 NPN(IS=1e-15 BF=100 T_ABS={IF(temp_choice==0,27,IF(temp_choice==1,TEMP,50))})
.ends
.op
.end
