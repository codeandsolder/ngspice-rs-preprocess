ngspice 47 nonlinear gate and diode depletion/diffusion capacitance sweep
.options gmin=1e-20
Vg g 0 0
Vd d 0 0
M1 d g 0 dut
.model dut vdmos (vto=3 kp=20 is=1e-14 cjo=1e-9 m=0.5 fc=0.5 tt=80n vp=0.4 cgdmin=20p cgdmax=2n a=1 cgs=1.4n)
.control
save @m1[cgd] @m1[cds] @m1[cgs]
dc Vd -0.4 0.6 0.2
print @m1[cgd] @m1[cds] @m1[cgs]
quit
.endc
.end
